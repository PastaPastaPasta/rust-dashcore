# S0p: one input's whole block budget in fan-out blocks, so that the node's coins cache passes
# its LARGE line (or THRESHOLD) and the flush is mirrored to Core; then a KILL.
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
restart kill
