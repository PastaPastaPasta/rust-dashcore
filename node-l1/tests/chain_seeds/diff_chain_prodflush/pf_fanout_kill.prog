# S0p: fan-out blocks at -dbcache=4 until the node's own size or threshold causes flush, each
# mirrored to Core under the node's label; then an explicit flush, matched, and a KILL.
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
flush always
extend main 8 tx=fan
restart kill
extend main 2
