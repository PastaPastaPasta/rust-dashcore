# S0p: fan-out blocks at -dbcache=4 until the node's own size or threshold causes flush, each
# mirrored to Core under the node's label; then an explicit flush, matched, and a KILL.
# It starts in IBD and leaves it at its second block, whose LEFT_IBD freeze the fan-out blocks
# build on: a restore at T_RECENT arms no LEFT_IBD (BL-969).
start old
extend main 1
warp 30
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
extend main 8 tx=fan
flush always
extend main 8 tx=fan
restart kill
extend main 2
