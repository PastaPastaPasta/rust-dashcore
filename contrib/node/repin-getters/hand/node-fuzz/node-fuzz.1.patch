+/// `headers2` flags: bits 0 to 2 the version's place in the list (0: on the wire); the previous
+/// block hash, the full timestamp and `nBits` are on the wire.
+const H2_VERSION_OFFSET: u8 = 0b0000_0111;
+const H2_PREV_HASH: u8 = 0b0000_1000;
+const H2_TIMESTAMP: u8 = 0b0001_0000;
+const H2_NBITS: u8 = 0b0010_0000;
+
+/// Reads one compressed header's wire fields and returns its flags: base-sdk's
+/// `CompressedHeader` read until fda80b21 made it private (headers2.rs:66-91 at b6853466).
+fn compressed_header_flags(data: &mut &[u8]) -> Option<u8> {
+    let flags = u8::decode(data).ok()?;
+    let mut skip = |n: usize| -> Option<()> {
+        *data = data.get(n..)?;
+        Some(())
+    };
+    if flags & H2_VERSION_OFFSET == 0 {
+        skip(4)?;
+    }
+    if flags & H2_PREV_HASH != 0 {
+        skip(32)?;
+    }
+    skip(32)?;
+    skip(if flags & H2_TIMESTAMP != 0 {
+        4
+    } else {
+        2
+    })?;
+    if flags & H2_NBITS != 0 {
+        skip(4)?;
+    }
+    skip(4)?;
+    Some(flags)
+}
