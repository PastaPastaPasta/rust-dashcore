diff --git a/dash-consensus/src/primitives/tx.rs b/dash-consensus/src/primitives/tx.rs
index de1e4109cd2c8fd603b27061f9da2b7461a62b92..c30c0bf2bc12eb5186626bdf3aef0942396bf46b 100644
--- a/dash-consensus/src/primitives/tx.rs
+++ b/dash-consensus/src/primitives/tx.rs
@@ -42,8 +42,21 @@ pub type TxRef = Arc<Tx>;
 impl Tx {
     /// `CTransaction(CMutableTransaction)`. Canonicalises `tx_type` to the decoder's
     /// representation.
-    pub fn new(mut raw: Transaction) -> Tx {
-        raw.tx_type = TxType::new(raw.tx_type().to_base());
+    pub fn new(raw: Transaction) -> Tx {
+        // base-sdk's fields are read-only: rebuild only a non-canonical type, which
+        // `TxType::new(to_base())` would change.
+        let raw = if raw.tx_type().is_canonical() {
+            raw
+        } else {
+            Transaction::new(
+                raw.version(),
+                TxType::new(raw.tx_type().to_base()),
+                raw.inputs().clone(),
+                raw.outputs().clone(),
+                raw.lock_time(),
+                raw.extra_payload().clone(),
+            )
+        };
         let serialized = raw.core_serialize();
         Tx::from_serialized(raw, &serialized)
     }
