@@ -300,8 +300,28 @@ pub fn bip69_output_cmp(a: &TxOut, b: &TxOut) -> std::cmp::Ordering {
 /// Sorts a transaction's inputs and outputs in BIP69 order. Core's `std::sort` is unstable;
 /// elements that compare equal here are byte-identical, so the order is the same (CJ0 notes D10).
 pub fn sort_bip69(tx: &mut Transaction) {
-    tx.inputs.sort_by(bip69_input_cmp);
-    tx.outputs.sort_by(bip69_output_cmp);
+    let mut inputs = tx.inputs().clone();
+    inputs.sort_by(bip69_input_cmp);
+    let mut outputs = tx.outputs().clone();
+    outputs.sort_by(bip69_output_cmp);
+    *tx = with_in_outs(tx, inputs, outputs);
+}
+
+/// `tx` with `inputs` and `outputs` in place of its own: base-sdk's fields are read-only, so a
+/// changed transaction is rebuilt.
+pub(crate) fn with_in_outs(
+    tx: &Transaction,
+    inputs: Vec<TxIn>,
+    outputs: Vec<TxOut>,
+) -> Transaction {
+    Transaction::new(
+        tx.version(),
+        tx.tx_type(),
+        inputs,
+        outputs,
+        tx.lock_time(),
+        tx.extra_payload().clone(),
+    )
 }
 
