+    /// `headers` as a `getheaders2` reply, one encoded header per entry (flags byte first): the
+    /// message's own encoding, split after the count by each entry's flags (full version, prev
+    /// hash, merkle root, full time or a 2-byte offset, nbits, nonce).
     fn wire2_parts(headers: &[BlockHeader]) -> Vec<Vec<u8>> {
-        Headers2::reply(headers)
+        let msg = Headers2::reply(headers);
+        let mut bytes = Vec::new();
