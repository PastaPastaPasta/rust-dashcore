+                let flags = c.flags();
+                assert_eq!(rest[0], flags);
+                let len =
+                    1 + if flags & 0b111 == 0 {
+                        4
+                    } else {
+                        0
+                    } + if flags & 0b1000 != 0 {
+                        32
+                    } else {
+                        0
+                    } + 32
+                        + if flags & 0b1_0000 != 0 {
+                            4
+                        } else {
+                            2
+                        }
+                        + if flags & 0b10_0000 != 0 {
+                            4
+                        } else {
+                            0
+                        }
+                        + 4;
+                let (part, tail) = rest.split_at(len);
+                rest = tail;
+                part.to_vec()
             })
-            .collect()
+            .collect();
+        assert!(rest.is_empty());
+        parts
     }
 
