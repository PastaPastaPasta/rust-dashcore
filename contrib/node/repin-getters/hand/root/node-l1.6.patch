+/// A shared-type payload's mirror (DEC-1066): base-sdk's, with public fields, which encodes as
+/// base-sdk does.
+#[derive(Clone)]
+enum Shared {
+    Dis(mirror::ProDisTx),
+    Share(mirror::ProUpShareTx),
+    Reg(mirror::ProUpSharedRegTx),
+}
+
+impl Shared {
+    fn of(p: &SpecialPayload) -> Self {
+        match p {
+            SpecialPayload::ProviderDissolve(p) => Self::Dis(p.into()),
+            SpecialPayload::ProviderUpdateShare(p) => Self::Share(p.into()),
+            SpecialPayload::ProviderUpdateSharedRegistrar(p) => Self::Reg(p.into()),
+            _ => unreachable!(),
+        }
+    }
+
+    fn to_bytes(&self) -> Vec<u8> {
+        match self {
+            Self::Dis(p) => p.to_bytes(),
+            Self::Share(p) => p.to_bytes(),
+            Self::Reg(p) => p.to_bytes(),
+        }
+    }
+}
