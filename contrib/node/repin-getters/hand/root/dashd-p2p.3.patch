+        /// `rebuilt` with `old`'s signature. A ProTx `new` leaves the payload unsigned and
+        /// base-sdk sets a signature only through `Signable::set_signature`, which verifies it,
+        /// so `old`'s signature bytes (`sig_wire`) replace `rebuilt`'s at the end of its encoding.
+        fn keep_sig<P: BaseCodec>(old: &P, rebuilt: &P, sig_wire: impl Fn(&P) -> Vec<u8>) -> P {
+            let mut wire = Vec::new();
+            rebuilt.encode(&mut wire);
+            let unsigned = sig_wire(rebuilt);
+            assert!(wire.ends_with(&unsigned), "the signature is the last field");
+            wire.truncate(wire.len() - unsigned.len());
+            wire.extend(sig_wire(old));
+            let out = P::decode(&mut &wire[..]).expect("the payload decodes");
+            assert_eq!(sig_wire(&out), sig_wire(old), "the signature decodes as it was");
+            out
+        }
+
