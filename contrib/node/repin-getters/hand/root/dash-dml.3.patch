+/// A ProTx payload whose signature, its last encoded field, base-sdk keeps private: it is set by
+/// `Signable::set_signature`, which verifies it, or `reset_signature`. A test that stores a given
+/// signature (any bytes, or one made for another key or scheme) uses [`WithSig::with_sig`].
+pub(crate) trait WithSig: BaseCodec + PartialEq + std::fmt::Debug + Sized {
+    type Sig: PartialEq + std::fmt::Debug;
+    fn sig_field(&self) -> &Self::Sig;
+    /// `sig` as this payload's encoding writes it.
+    fn sig_wire(&self, sig: &Self::Sig) -> Vec<u8>;
+
+    /// The payload with `sig` in place of its signature: its encoding with the signature's bytes
+    /// replaced, decoded. Asserts the payload round-trips and the signature decodes as `sig`, so
+    /// the result equals the payload with only the signature changed.
+    fn with_sig(&self, sig: Self::Sig) -> Self {
+        let mut wire = encoded(self);
+        let back = Self::decode(&mut &wire[..]).expect("the payload decodes");
+        assert_eq!(&back, self, "the payload round-trips");
+        let old = self.sig_wire(self.sig_field());
+        assert!(wire.ends_with(&old), "the signature is the last field");
+        wire.truncate(wire.len() - old.len());
+        wire.extend(self.sig_wire(&sig));
+        let out = Self::decode(&mut &wire[..]).expect("the payload decodes with the signature");
+        assert_eq!(out.sig_field(), &sig, "the signature decodes as set");
+        out
+    }
+}
+
+impl WithSig for dash_primitives::ProRegTx {
+    type Sig = dash_primitives::CollateralSig;
+    fn sig_field(&self) -> &Self::Sig {
+        self.sig()
+    }
+    fn sig_wire(&self, sig: &Self::Sig) -> Vec<u8> {
+        encoded(sig)
+    }
+}
+
+impl WithSig for dash_primitives::ProUpRegTx {
+    type Sig = dash_primitives::OwnerSig;
+    fn sig_field(&self) -> &Self::Sig {
+        self.sig()
+    }
+    fn sig_wire(&self, sig: &Self::Sig) -> Vec<u8> {
+        encoded(sig)
+    }
+}
+
+impl WithSig for dash_primitives::ProUpServTx {
+    type Sig = dash_pkc::bls::BlsEagerSig;
+    fn sig_field(&self) -> &Self::Sig {
+        self.sig()
+    }
+    fn sig_wire(&self, sig: &Self::Sig) -> Vec<u8> {
+        encoded(&sig.to_bytes(dash_primitives::protx_bls_scheme(self.version())))
+    }
+}
+
+impl WithSig for dash_primitives::ProUpRevTx {
+    type Sig = dash_pkc::bls::BlsEagerSig;
+    fn sig_field(&self) -> &Self::Sig {
+        self.sig()
+    }
+    fn sig_wire(&self, sig: &Self::Sig) -> Vec<u8> {
+        encoded(&sig.to_bytes(dash_primitives::protx_bls_scheme(self.version())))
+    }
+}
