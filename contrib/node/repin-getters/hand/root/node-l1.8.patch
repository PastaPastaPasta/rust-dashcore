+    /// Core's `MakeSignString`, which the key of an external collateral signs as a text message:
+    /// the payout, the operator reward, the owner and voting addresses and the payload hash,
+    /// separated by `|`. It depends on the network through the address prefixes in `addr`.
+    #[must_use]
+    pub fn sign_string(&self, addr: &AddrParams) -> String {
+        let mut unsigned = Vec::new();
+        self.encode_unsigned(&mut unsigned);
+        let hash = hash256(&unsigned);
+        let payout = if self.version >= ProTxVersion::ExtAddr {
+            let entries: Vec<String> = self
+                .payouts
+                .iter()
+                .map(|payout| {
+                    format!(
+                        "{}:{}",
+                        destination_string(payout.script_payout().as_bytes(), addr),
+                        payout.reward()
+                    )
+                })
+                .collect();
+            entries.join(",")
+        } else {
+            destination_string(self.script_payout.as_bytes(), addr)
+        };
+        format!(
+            "{payout}|{}|{}|{}|{}",
+            self.operator_reward,
+            self.key_id_owner.to_base58c(addr.pubkey_addr),
+            self.key_id_voting.to_base58c(addr.pubkey_addr),
