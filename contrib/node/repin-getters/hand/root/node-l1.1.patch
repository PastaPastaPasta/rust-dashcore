+
+// The encoders. Each follows base-sdk's at fda80b21, file and function named; the private helpers
+// it calls are copied below with their sources.
+
+impl ProRegTx {
+    /// `pkgs/primitives/src/provider/proregtx.rs`: `encode` (`encode_unsigned`, then `sig`).
+    fn encode_payload(&self, buf: &mut impl EncodeBuf) {
+        self.encode_unsigned(buf);
+        self.sig.encode(buf);
+    }
+
+    /// `proregtx.rs` `encode_unsigned`, base-sdk's `sig_hash_bytes`.
+    fn encode_unsigned(&self, buf: &mut impl EncodeBuf) {
+        self.version.encode(buf);
+        self.mn_type.to_base().encode(buf);
+        self.mode.encode(buf);
+        self.collateral_hash.encode(buf);
+        self.collateral_index.encode(buf);
+        write_net_info(buf, &self.net_info, self.version);
+        self.key_id_owner.encode(buf);
+        write_lazy(&self.pub_key_operator, protx_bls_scheme(self.version), buf);
+        self.key_id_voting.encode(buf);
+        self.operator_reward.encode(buf);
+        if self.version >= ProTxVersion::ExtAddr {
+            write_list(&self.payouts, buf);
+            write_list(&self.shares, buf);
+            write_items(&self.join_sigs, buf);
+            self.early_period_blocks.encode(buf);
+            self.early_penalty.encode(buf);
+        } else {
+            self.script_payout.encode(buf);
+        }
+        self.inputs_hash.encode(buf);
+        write_platform_fields(
+            buf,
+            self.mn_type,
+            self.version,
+            &self.platform_node_id,
+            self.platform_p2p_port,
+            self.platform_http_port,
+        );
+    }
+}
+
+impl ProUpServTx {
+    /// `pkgs/primitives/src/provider/proupservtx.rs`: `encode` (`encode_unsigned`, then `sig`
+    /// under the version's scheme).
+    fn encode_payload(&self, buf: &mut impl EncodeBuf) {
+        self.encode_unsigned(buf);
+        self.sig.to_bytes(protx_bls_scheme(self.version)).encode(buf);
+    }
+
+    /// `proupservtx.rs` `encode_unsigned`.
+    fn encode_unsigned(&self, buf: &mut impl EncodeBuf) {
+        self.version.encode(buf);
+        if self.version >= ProTxVersion::BasicBls {
+            self.mn_type.to_base().encode(buf);
+        }
+        self.pro_tx_hash.encode(buf);
+        write_net_info(buf, &self.net_info, self.version);
+        self.script_operator_payout.encode(buf);
+        self.inputs_hash.encode(buf);
+        write_platform_fields(
+            buf,
+            self.mn_type,
+            self.version,
+            &self.platform_node_id,
+            self.platform_p2p_port,
+            self.platform_http_port,
+        );
+    }
+}
+
+impl ProUpRegTx {
+    /// base-sdk's setter (`#[getset(set = "pub")]`).
+    pub fn set_version(&mut self, version: ProTxVersion) -> &mut Self {
+        self.version = version;
+        self
+    }
+
+    /// `pkgs/primitives/src/provider/proupregtx.rs`: `encode` (`encode_unsigned`, then `sig`).
+    fn encode_payload(&self, buf: &mut impl EncodeBuf) {
+        self.encode_unsigned(buf);
+        self.sig.encode(buf);
+    }
+
+    /// `proupregtx.rs` `encode_unsigned`.
+    fn encode_unsigned(&self, buf: &mut impl EncodeBuf) {
+        self.version.encode(buf);
+        self.pro_tx_hash.encode(buf);
+        self.mode.encode(buf);
+        write_lazy(&self.pub_key_operator, protx_bls_scheme(self.version), buf);
+        self.key_id_voting.encode(buf);
+        if self.version >= ProTxVersion::ExtAddr {
+            write_list(&self.payouts, buf);
+        } else {
+            self.script_payout.encode(buf);
+        }
+        self.inputs_hash.encode(buf);
+    }
+}
+
+impl ProUpRevTx {
+    /// base-sdk's setter (`#[getset(set = "pub")]`).
+    pub fn set_version(&mut self, version: ProTxVersion) -> &mut Self {
+        self.version = version;
+        self
+    }
+
+    /// `pkgs/primitives/src/provider/prouprevtx.rs`: `encode` (`encode_unsigned`, then `sig`
+    /// under the version's scheme).
+    fn encode_payload(&self, buf: &mut impl EncodeBuf) {
+        self.encode_unsigned(buf);
+        self.sig.to_bytes(protx_bls_scheme(self.version)).encode(buf);
+    }
+
+    /// `prouprevtx.rs` `encode_unsigned`.
+    fn encode_unsigned(&self, buf: &mut impl EncodeBuf) {
+        self.version.encode(buf);
+        self.pro_tx_hash.encode(buf);
+        self.reason.encode(buf);
+        self.inputs_hash.encode(buf);
+    }
+}
+
+impl ProDisTx {
+    /// `pkgs/primitives/src/provider/prodistx.rs`: `encode`.
+    fn encode_payload(&self, buf: &mut impl EncodeBuf) {
+        self.version.encode(buf);
+        self.pro_tx_hash.encode(buf);
+        self.actor_index.encode(buf);
+        write_list(&self.sigs, buf);
+    }
+}
+
+impl ProUpShareTx {
+    /// `pkgs/primitives/src/provider/proupsharetx.rs`: `codec_type!`'s `encode`
+    /// (`pkgs/primitives/src/codec.rs` `codec_base!`), every field in declaration order.
+    fn encode_payload(&self, buf: &mut impl EncodeBuf) {
+        self.encode_unsigned(buf);
+        self.sig.encode(buf);
+    }
+
+    /// `proupsharetx.rs` `sig_hash_bytes`: every field but `sig`.
+    fn encode_unsigned(&self, buf: &mut impl EncodeBuf) {
+        self.version.encode(buf);
+        self.pro_tx_hash.encode(buf);
+        self.share_index.encode(buf);
+        self.script_reward.encode(buf);
+        self.inputs_hash.encode(buf);
+    }
+}
+
+impl ProUpSharedRegTx {
+    /// `pkgs/primitives/src/provider/proupsharedregtx.rs`: `encode` (`encode_unsigned`, then the
+    /// signature list).
+    fn encode_payload(&self, buf: &mut impl EncodeBuf) {
+        self.encode_unsigned(buf);
+        write_list(&self.sigs, buf);
+    }
+
+    /// `proupsharedregtx.rs` `encode_unsigned`: the operator key always under the basic scheme.
+    fn encode_unsigned(&self, buf: &mut impl EncodeBuf) {
+        self.version.encode(buf);
+        self.pro_tx_hash.encode(buf);
+        write_lazy(&self.pub_key_operator, BlsSchemeKind::Basic, buf);
+        self.key_id_voting.encode(buf);
+        self.inputs_hash.encode(buf);
+    }
+}
+
+/// `SER_GETHASH`, base-sdk's `sig_hash_bytes`: the payload without its signature, which
+/// dash-dml's `payload_sig_hash` hashes. The mirror's own encoding, so a signature over a payload
+/// base-sdk's decode would read differently still covers the payload's bytes.
+macro_rules! signed_payload {
+    ($($t:ty),+) => {
+        $(impl dash_dml::specialtx::sig::SignedPayload for $t {
+            fn sig_hash_bytes(&self) -> Option<Vec<u8>> {
+                let mut buf = Vec::new();
+                self.encode_unsigned(&mut buf);
+                Some(buf)
+            }
+        })+
+    };
+}
+
+signed_payload!(ProRegTx, ProUpServTx, ProUpRegTx, ProUpRevTx, ProUpShareTx, ProUpSharedRegTx);
+
+// base-sdk's private helpers, copied.
+
+/// `pkgs/primitives/src/provider/mod.rs` `write_net_info`: the network info the payload version
+/// selects; a variant the version does not select writes nothing.
+fn write_net_info(buf: &mut impl EncodeBuf, net_info: &NetInfo, version: ProTxVersion) {
+    if version >= ProTxVersion::ExtAddr {
+        if let NetInfo::Extended(ext) = net_info {
+            ext.encode(buf);
+        }
+    } else if let NetInfo::Legacy(svc) = net_info {
+        svc.encode(buf);
+    }
+}
+
+/// `pkgs/primitives/src/provider/mod.rs` `write_platform_fields`: an Evo node's node id, and its
+/// ports below ExtAddr, absent ones as their defaults.
+fn write_platform_fields(
+    buf: &mut impl EncodeBuf,
+    mn_type: MnType,
+    version: ProTxVersion,
+    platform_node_id: &Option<PlatformNodeId>,
+    platform_p2p_port: Option<u16>,
+    platform_http_port: Option<u16>,
+) {
+    if mn_type == MnType::Evo {
+        platform_node_id.unwrap_or_default().encode(buf);
+        if version < ProTxVersion::ExtAddr {
+            platform_p2p_port.unwrap_or(0).encode(buf);
+            platform_http_port.unwrap_or(0).encode(buf);
+        }
+    }
+}
+
+/// `pkgs/primitives/src/payload/bls.rs` `write_lazy` (`lazy_bytes`): the key's object under
+/// `scheme`, zeros when invalid, resolved on a copy so the field stays as it was.
+fn write_lazy(field: &BlsLazyPk, scheme: BlsSchemeKind, buf: &mut impl EncodeBuf) {
+    field.clone().get().to_bytes(scheme).encode(buf);
+}
+
+/// `pkgs/primitives/src/provider/shares.rs` `write_items`: the items with no count.
+fn write_items<T: BaseCodec>(items: &[T], buf: &mut impl EncodeBuf) {
+    for item in items {
+        item.encode(buf);
+    }
+}
+
+/// `shares.rs` `write_list`: a one-byte count, cast as Core casts it (a count above 255 wraps),
+/// and every item.
+#[allow(clippy::cast_possible_truncation)] // Core's `uint8_t` cast, as base-sdk's
+fn write_list<T: BaseCodec>(items: &[T], buf: &mut impl EncodeBuf) {
+    (items.len() as u8).encode(buf);
+    write_items(items, buf);
+}
diff --git a/node-l1/src/protx_mirror/tests.rs b/node-l1/src/protx_mirror/tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9c57a1f49d50b04c65db38ee0bec60c9f44e64de
--- /dev/null
+++ b/node-l1/src/protx_mirror/tests.rs
@@ -0,0 +1,188 @@
+//! The mirror's encoder against base-sdk's (DEC-1066 condition 2), on every valid provider payload
+//! of the mirrored types in the vectors node-l1 reaches: Core's fixtures (`trivially_valid.json`,
+//! `trivially_invalid.json`, the oracle's recorded transactions and blocks) and dash-dml's
+//! vector files. A payload is valid when base-sdk decodes it whole. For each one:
+//!
+//! 1. the mirror read from base-sdk's payload encodes to base-sdk's encoding, byte for byte, and
+//!    so does its signature hash (`SER_GETHASH`, dash-dml's `SignedPayload`);
+//! 2. base-sdk's decode of the mirror's bytes is the payload base-sdk's own encoding decodes to,
+//!    by `PartialEq` and by `Debug` (which also shows a lazy key's scheme), and the payload itself
+//!    whenever base-sdk's own round trip gives it back.
+//!
+//! The test fails if a (type, version) pair of [`EXPECTED`] finds no vector.
+
+use std::collections::BTreeMap;
+use std::fmt::Debug;
+
+use dash_dml::specialtx::sig::payload_sig_hash;
+use dash_primitives::{Block, Transaction};
+use dash_types::Numeric;
+use dash_types::codec::BaseCodec;
+
+use super::ToBsdk;
+
+/// Files holding transactions or blocks as hex, relative to the workspace root.
+const FILES: &[&str] = &[
+    "dash-oracle-sys/tests/data/special-tx-signatures.json",
+    "dash-oracle-sys/tests/data/dml-crafted-v24.0.json",
+    "dash-oracle-sys/tests/data/contextual-mainnet.json",
+    "dash-oracle-sys/tests/data/contextual-regtest-v24.0.json",
+    "dash-oracle-sys/tests/data/testnet.json",
+    "dash-dml/tests/data/core_signed_protx.txt",
+    "dash-dml/tests/data/ev2b-quirks.txt",
+    "node-l1/tests/data/proupserv-mainnet-1028257.json",
+    "node-l1/src/dml_apply/shared-case.json",
+];
+
+/// Core's own fixtures, under `src/test/data` of the vendored tree (`dash-core-vectors`).
+const CORE_FILES: &[&str] =
+    &["src/test/data/trivially_valid.json", "src/test/data/trivially_invalid.json"];
+
+/// Every (type, version) pair the files above hold, which the test must reach.
+const EXPECTED: &[(u16, u16)] = &[
+    (1, 1),
+    (1, 2),
+    (1, 3),
+    (2, 1),
+    (2, 2),
+    (2, 3),
+    (3, 1),
+    (3, 2),
+    (3, 3),
+    (4, 1),
+    (4, 2),
+    (4, 3),
+    (10, 1),
+    (11, 1),
+    (12, 1),
+];
+
+/// The runs of at least 120 hex digits of even length in `text`.
+fn hex_runs(text: &str) -> Vec<Vec<u8>> {
+    let mut out = Vec::new();
+    let mut run = String::new();
+    for c in text.chars().chain(std::iter::once(' ')) {
+        if c.is_ascii_hexdigit() {
+            run.push(c);
+            continue;
+        }
+        if run.len() >= 120 && run.len().is_multiple_of(2) {
+            let bytes = (0..run.len())
+                .step_by(2)
+                .map(|i| u8::from_str_radix(&run[i..i + 2], 16))
+                .collect::<Result<Vec<u8>, _>>();
+            out.extend(bytes.ok());
+        }
+        run.clear();
+    }
+    out
+}
+
+/// The special transactions in `bytes`: one transaction or one block, decoded whole by base-sdk.
+fn special_txs(bytes: &[u8]) -> Vec<Transaction> {
+    let mut data = bytes;
+    if let Ok(tx) = Transaction::decode(&mut data)
+        && data.is_empty()
+    {
+        return vec![tx];
+    }
+    let mut data = bytes;
+    match Block::decode(&mut data) {
+        Ok(block) if data.is_empty() => block.transactions().clone(),
+        _ => Vec::new(),
+    }
+}
+
+/// One payload's checks; `false` when base-sdk does not decode it whole (not a valid payload).
+#[allow(clippy::use_debug, clippy::expect_used)] // the comparison is of the Debug forms
+fn check<M>(
+    payload: &[u8],
+    signed: Option<fn(&M, &M::Bsdk) -> (Option<[u8; 32]>, Option<[u8; 32]>)>,
+) -> bool
+where
+    M: ToBsdk + for<'a> From<&'a M::Bsdk> + PartialEq + Debug,
+    M::Bsdk: PartialEq + Debug,
+{
+    let mut data = payload;
+    let Ok(p) = M::Bsdk::decode(&mut data) else {
+        return false;
+    };
+    if !data.is_empty() {
+        return false;
+    }
+    let mut want = Vec::new();
+    p.encode(&mut want);
+    let m = M::from(&p);
+    assert_eq!(m.to_bytes(), want, "mirror encoding of {p:?}");
+    if let Some(hashes) = signed {
+        let (ours, theirs) = hashes(&m, &p);
+        assert!(ours.is_some(), "a signature hash");
+        assert_eq!(ours, theirs, "signature hash of {p:?}");
+    }
+    let back = m.to_bsdk().expect("base-sdk decodes the mirror's bytes whole");
+    let own = M::Bsdk::decode(&mut want.as_slice()).expect("base-sdk decodes its own encoding");
+    assert_eq!(back, own, "round trip of {p:?}");
+    assert_eq!(format!("{back:?}"), format!("{own:?}"), "round trip of {p:?}");
+    if own == p && format!("{own:?}") == format!("{p:?}") {
+        assert_eq!(back, p);
+    }
+    assert_eq!(M::from(&back), M::from(&own));
+    true
+}
+
+macro_rules! sig_hash {
+    ($t:ident) => {
+        Some(|m: &super::$t, p: &dash_primitives::$t| (payload_sig_hash(m), payload_sig_hash(p)))
+    };
+}
+
+#[test]
+#[allow(clippy::expect_used)]
+fn mirror_encodes_as_base_sdk() {
+    let root = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
+    let mut texts: Vec<(String, String)> = FILES
+        .iter()
+        .map(|f| {
+            let text = std::fs::read_to_string(format!("{root}/{f}")).expect("a vector file");
+            ((*f).to_owned(), text)
+        })
+        .collect();
+    texts
+        .extend(CORE_FILES.iter().map(|f| ((*f).to_owned(), dash_core_vectors::read_core_text(f))));
+
+    let mut seen: BTreeMap<(u16, u16), usize> = BTreeMap::new();
+    let mut files: BTreeMap<&str, usize> = BTreeMap::new();
+    for (file, text) in &texts {
+        for bytes in hex_runs(text) {
+            for tx in special_txs(&bytes) {
+                let payload = tx.extra_payload().as_slice();
+                let ty = tx.tx_type().to_base();
+                let ok = match ty {
+                    1 => check::<super::ProRegTx>(payload, sig_hash!(ProRegTx)),
+                    2 => check::<super::ProUpServTx>(payload, sig_hash!(ProUpServTx)),
+                    3 => check::<super::ProUpRegTx>(payload, sig_hash!(ProUpRegTx)),
+                    4 => check::<super::ProUpRevTx>(payload, sig_hash!(ProUpRevTx)),
+                    10 => check::<super::ProDisTx>(payload, None),
+                    11 => check::<super::ProUpShareTx>(payload, sig_hash!(ProUpShareTx)),
+                    12 => check::<super::ProUpSharedRegTx>(payload, sig_hash!(ProUpSharedRegTx)),
+                    _ => false,
+                };
+                if ok {
+                    let version = u16::from_le_bytes([payload[0], payload[1]]);
+                    *seen.entry((ty, version)).or_default() += 1;
+                    *files.entry(file.as_str()).or_default() += 1;
+                }
+            }
+        }
+    }
+    eprintln!("protx mirror round trip: {} cases", seen.values().sum::<usize>());
+    for ((ty, version), n) in &seen {
+        eprintln!("  type {ty} version {version}: {n}");
+    }
+    for (file, n) in &files {
+        eprintln!("  {file}: {n}");
+    }
+    for pair in EXPECTED {
+        assert!(seen.contains_key(pair), "no vector of (type, version) {pair:?}");
+    }
+}
