+}
+
+mirror! {
+    /// base-sdk's `ProUpRegTx` (type 3).
+    ProUpRegTx {
+        copy version: ProTxVersion,
+        copy pro_tx_hash: TxHash,
+        copy mode: u16,
+        get pub_key_operator: BlsLazyPk,
+        copy key_id_voting: PubKeyHash,
