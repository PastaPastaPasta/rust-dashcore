+/// [`at_version`] gives each version the fields `SERIALIZE_METHODS(CCbTx)` writes for it
+/// (`evo/cbtx.h:54-70`): a missing one at `CCbTx`'s default, one past the version dropped, so
+/// the encode is Core's and decodes back to the same value.
+#[test]
+#[expect(
+    clippy::disallowed_methods,
+    reason = "the test reads base-sdk's own encode of the payload"
+)]
+fn at_version_has_the_fields_its_version_serializes() {
+    let with = |version: u16, full: bool| {
+        CoinbaseCommitment::new(
+            CbCommitmentVersion::new(version),
+            432_u32.into(),
+            MerkleRoot::from_lendian([1; 32]),
+            full.then(|| MerkleRoot::from_lendian([2; 32])),
+            full.then_some(7),
+            full.then(null_signature),
+            full.then_some(9),
+            full.then(|| MerkleRoot::from_lendian([3; 32])),
+        )
+    };
+    let encoded = |cbtx: &CoinbaseCommitment| {
+        let mut bytes = Vec::new();
+        cbtx.encode(&mut bytes);
+        bytes
+    };
+    // nVersion + nHeight + merkleRootMNList, then 32, 1 + 96 + 8 and 32 bytes from 2, 3 and 4.
+    for (version, len) in [(0, 38), (1, 38), (2, 70), (3, 175), (4, 207), (5, 207)] {
+        for full in [false, true] {
+            let cbtx = at_version(&with(version, full));
+            let bytes = encoded(&cbtx);
+            assert_eq!(bytes.len(), len, "v{version} full {full}");
+            assert_eq!(CoinbaseCommitment::decode(&mut &bytes[..]), Ok(cbtx.clone()), "v{version}");
+            if !full {
+                assert!(bytes[38..].iter().all(|&b| b == 0), "v{version}: CCbTx's defaults");
+            }
+        }
+    }
+    assert_eq!(at_version(&with(4, true)), with(4, true));
+}
