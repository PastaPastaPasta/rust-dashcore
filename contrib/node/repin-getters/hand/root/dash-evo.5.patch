+/// `cbtx` with the fields its version serializes and no others, which is what Core writes for a
+/// `CCbTx` (a field the version has and `cbtx` lacks takes `CCbTx`'s default: a zero height
+/// diff and balance, the null signature, null roots). base-sdk's encode writes the fields that
+/// are present whatever the version, so a value built or edited field by field goes through
+/// this before it is encoded as Core would.
+// Core: evo/cbtx.h:54-70 SERIALIZE_METHODS(CCbTx)
+pub fn at_version(cbtx: &CoinbaseCommitment) -> CoinbaseCommitment {
+    let version = cbtx.version().to_base();
+    let from = |first: u16| version >= first;
+    let with_cl = from(CBTX_VERSION_CLSIG_AND_BALANCE);
+    CoinbaseCommitment::new(
+        cbtx.version(),
+        cbtx.height(),
+        cbtx.merkle_root_mn_list(),
+        from(CBTX_VERSION_MERKLE_ROOT_QUORUMS)
+            .then(|| cbtx.merkle_root_quorums().unwrap_or_default()),
+        with_cl.then(|| cbtx.best_cl_height_diff().unwrap_or(0)),
+        with_cl.then(|| cbtx.best_cl_signature().clone().unwrap_or_else(null_signature)),
+        with_cl.then(|| cbtx.credit_pool_balance().unwrap_or(0)),
+        from(CBTX_VERSION_MERKLE_ROOT_ASSETUNLOCKS)
+            .then(|| cbtx.merkle_root_asset_unlocks().unwrap_or_default()),
+    )
+}
+
+/// `CCbTx::bestCLSignature` left default: Core's `CBLSSignature()` is invalid, and
+/// `CBLSWrapper` writes an invalid object as zeros under either scheme.
+pub fn null_signature() -> BlsGlobalSig {
+    BlsGlobalSig::decode(&[0; 96]).expect("zeros decode under either scheme")
+}
