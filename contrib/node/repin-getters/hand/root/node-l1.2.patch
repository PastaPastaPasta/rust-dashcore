+/// `p` encoded with `signers` and `valid` as its bitsets of `num_bits` bits, as given: base-sdk's
+/// `DynBitset` refuses a short image or a set padding bit, which these inputs make on purpose
+/// (Core's decode refuses them too). `p`'s own bitsets are empty; the two follow the commitment's
+/// head in Core's layout (`nVersion`, `nHeight`, `nVersion`, `llmqType`, `quorumHash`,
+/// `quorumIndex` when indexed), each its bit count then its bytes.
+// Core: llmq/commitment.h (CFinalCommitment SERIALIZE_METHODS)
+fn with_raw_bitsets(
+    p: &FinalCommitment,
+    num_bits: u64,
+    signers: &[u8],
+    valid: &[u8],
+) -> Option<Vec<u8>> {
+    let bytes = encoded(p);
+    let head = 2
+        + 4
+        + 2
+        + 1
+        + 32
+        + if p.commitment().quorum_index().is_some() {
+            2
+        } else {
+            0
+        };
+    let empty = &[0u8, 0];
+    if bytes.get(head..head + 2)? != empty {
+        return None;
+    }
+    let mut out = bytes[..head].to_vec();
+    for bits in [signers, valid] {
+        CompactSize::from(num_bits).encode(&mut out);
+        out.extend_from_slice(bits);
+    }
+    out.extend_from_slice(&bytes[head + 2..]);
+    Some(out)
+}
