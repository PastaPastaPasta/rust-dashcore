#!/usr/bin/env bash
# st3b-priv: the ST3b power-loss harness's only privileged entry point (run as `sudo -n st3b-priv
# <verb> ...`). Every verb refuses anything outside the harness's root: loop devices only on files
# under $ROOT/run, device-mapper devices only named st3b-* and built only on those, mounts only
# under $ROOT/mnt. It never runs `dmsetup remove_all`, `losetup -D` or `umount -l`.
#
# A guard against harness bugs, not a privilege boundary: the grant it runs under is the box's
# blanket NOPASSWD sudo, the script and $ROOT are writable by the user it serves, and its path
# checks race with that user's renames (ST3b-D5's L5). A sudoers rule naming only this script
# would need a root-owned copy and root-owned mount directories first (ST3b r1 m-1).
#
#   losetup-attach <file>             attach a loop device, print /dev/loopN
#   losetup-detach </dev/loopN>       detach one of ours
#   dm-create <name> <table>          create st3b-* (targets: log-writes, linear, flakey)
#   dm-swap <name> <segment>...       replace a live st3b-* table, one segment per argument
#                                     (`<start> <len> linear <dev> <start>`, or the always-down
#                                     flakey form): suspend without freezing the filesystem (a
#                                     freeze would write back every dirty page), load, resume,
#                                     stable pages again; resumed again on any failure
#   dm-remove <name>                  retries for up to 2 min while busy
#   stable-writes <name>              require stable pages of st3b-* (before its fs is mounted)
#   dm-message <name> mark <word>     a log-writes mark
#   mkfs <dev> ext4|xfs               without discard, inode tables written up front
#   mount <dev> <mnt> ext4|xfs [ro]   nodev,nosuid,noexec; ext4 gets errors=continue (a write
#                                     error leaves the fail-stop to rdashd, ST3b S6); xfs gets
#                                     nouuid (reflinked copies share the UUID)
#   umount <mnt>                      <mnt> is a parent that resolves to $ROOT/mnt or under it, and
#                                     a plain name ([A-Za-z0-9._-], not . or ..), taken as given
#   holders <mnt>                     read-only, <mnt> as for umount: who holds the filesystem
#                                     (BL-762), each section titled, capped and `none` if empty,
#                                     every scan under `timeout`, about 120 s at most in all, a
#                                     scan cut short or failing named in its section: fuser,
#                                     lsof, the processes and threads whose cwd, root, exe, fds or
#                                     maps are on its device or whose fds are on one of its mounts
#                                     by mount ID (pid/tid and comm, never cmdlines), loop devices
#                                     and swap files on it, and its copies in every mount
#                                     namespace (propagation, mounts on top, pids with fds on the
#                                     copy), busiest first
#   chown-mnt <mnt>                   give the mounted root to the invoking user
#   sweep <run>                       resume, unmount, remove and detach everything of run <run>
#                                     (a failed unmount prints `holders` to stderr);
#                                     exit 3, touching nothing, if the run's lock is held (alive);
#                                     exit 4, touching nothing, if its directory is gone while it
#                                     still has devices or mounts (an orphan: a live run pruned
#                                     under itself looks the same, so a person decides)
#   leaks [<run>]                     list our devices and mounts (all runs, or one)
#   kernel <dest>                     copy /boot/vmlinuz-$(uname -r) to a new file <dest> under
#                                     $ROOT/vm/ (S7's guest kernel), owned by the invoking user,
#                                     mode 0444, checked against the source's sha256 by that
#                                     user; print `<sha256>  <dest>`
set -euo pipefail
umask 077

ROOT=/work/scratch/st3b
MNT=$ROOT/mnt
PATH=/usr/sbin:/usr/bin:/sbin:/bin

die() {
	echo "st3b-priv: $*" >&2
	exit 2
}

[ "$(id -u)" = 0 ] || die "run me with sudo -n"

# A path's resolved form must lie strictly under $1.
under() {
	local base=$1 path
	path=$(realpath -e -- "$2" 2>/dev/null) || return 1
	case $path in "$base"/?*) printf '%s\n' "$path" ;; *) return 1 ;; esac
}

dm_name() {
	[[ $1 =~ ^st3b-[A-Za-z0-9._-]{1,100}$ ]] || die "not an st3b-* device name: $1"
}

# `<utc seconds>-<pid>`, as the harness makes them.
run_id() {
	[[ $1 =~ ^[0-9]{1,20}-[0-9]{1,10}$ ]] || die "bad run id: $1"
}

# A loop device whose backing file is under $ROOT/run, where `losetup-attach` makes them and
# `leaks` looks. The file may be gone (a point image the harness removed after a failed detach):
# then its recorded path, canonical when attached, counts.
our_loop() {
	local back
	[[ $1 =~ ^/dev/loop[0-9]+$ ]] || return 1
	back=$(losetup -nO BACK-FILE "$1" 2>/dev/null) || return 1
	back=${back%% (deleted)}
	case $back in */../* | */./* | */..) return 1 ;; "$ROOT"/run/?*) ;; *) return 1 ;; esac
	[ ! -e "$back" ] || under "$ROOT/run" "$back" >/dev/null
}

# A block device the harness may build on, format or mount: one of our loops or st3b-* dm devices.
our_dev() {
	case $1 in
	/dev/mapper/st3b-*) dm_name "${1#/dev/mapper/}" && [ -b "$1" ] ;;
	/dev/loop*) our_loop "$1" ;;
	*) return 1 ;;
	esac
}

# dm-log-writes copies a write's data when it maps the bio; without stable pages the fs may change
# the page before the device reads it, so the device can hold bytes the log never saw. A table
# load recomputes the flag from the devices below, so a swap that leaves writes flowing sets it
# again.
set_stable_writes() {
	local dev
	[ -b "/dev/mapper/$1" ] || die "no such device: $1"
	dev=$(realpath -e "/dev/mapper/$1")
	[[ $dev =~ ^/dev/dm-[0-9]+$ ]] || die "not a device-mapper node: $dev"
	echo 1 >"/sys/block/${dev#/dev/}/queue/stable_writes"
}

# A swapped table over a device of $1 sectors, one segment per later argument: each
# `<start> <len> linear <dev> <start>` or `<start> <len> flakey <dev> <start> 0 1 1 error_writes`
# (an identity map, always down for writes), all on one of our devices, the first at 0, each
# starting where the last ended, the last ending at $1. A segment is a single line of plain words,
# as in `check_table`, its numbers at most 18 digits (bash arithmetic wraps past 2^63, Opus r1 n1).
check_segments() {
	local size=$1 at=0 dev="" seg
	local -a t
	shift
	for seg in "$@"; do
		[[ $seg =~ ^[0-9]{1,18}\ [1-9][0-9]{0,17}\ (linear|flakey)(\ [A-Za-z0-9/._-]+)+$ ]] ||
			die "segment not allowed: $seg"
		read -r -a t <<<"$seg"
		[ "${t[0]}" = "$at" ] || die "segment not contiguous at $at: $seg"
		[ "${t[4]:-}" = "${t[0]}" ] || die "segment not an identity map: $seg"
		case ${t[2]} in
		linear) [ ${#t[@]} = 5 ] || die "linear segment: <start> <len> linear <dev> <start>" ;;
		flakey)
			[ ${#t[@]} = 9 ] && [ "${t[*]:5}" = "0 1 1 error_writes" ] ||
				die "flakey segment: <start> <len> flakey <dev> <start> 0 1 1 error_writes"
			;;
		esac
		our_dev "${t[3]}" || die "device not ours: ${t[3]}"
		[ -z "$dev" ] || [ "$dev" = "${t[3]}" ] || die "segments on two devices: $seg"
		dev=${t[3]}
		at=$((t[0] + t[1]))
	done
	[ "$at" = "$size" ] || die "segments cover $at of $size sectors"
}

# A table: exactly one line `0 <len> <target> <args>` of plain words (the kernel unescapes `\`,
# splits on any whitespace and resolves relative paths, so nothing else may get through), with
# each target's arguments checked by position: a device must be ours, everything else a number.
check_table() {
	local -a t a
	[[ $1 =~ ^0\ [1-9][0-9]*\ (linear|log-writes|flakey)(\ [A-Za-z0-9/._-]+)+$ ]] ||
		die "table not allowed: $1"
	read -r -a t <<<"$1"
	a=("${t[@]:3}")
	dev_arg() { our_dev "$1" || die "device not ours: $1"; }
	num_arg() { [[ $1 =~ ^[0-9]+$ ]] || die "not a number: $1"; }
	case ${t[2]} in
	linear)
		[ ${#a[@]} = 2 ] || die "linear <dev> <offset>"
		dev_arg "${a[0]}"
		num_arg "${a[1]}"
		;;
	log-writes)
		[ ${#a[@]} = 2 ] || die "log-writes <data dev> <log dev>"
		dev_arg "${a[0]}"
		dev_arg "${a[1]}"
		;;
	flakey)
		# <dev> <offset> <up s> <down s>, then no features or the one S6 uses.
		[ ${#a[@]} = 4 ] || { [ ${#a[@]} = 6 ] && [ "${a[4]} ${a[5]}" = "1 error_writes" ]; } ||
			die "flakey <dev> <offset> <up> <down> [1 error_writes]"
		dev_arg "${a[0]}"
		num_arg "${a[1]}"
		num_arg "${a[2]}"
		num_arg "${a[3]}"
		;;
	esac
}

mnt_path() {
	under "$MNT" "$1" || die "mountpoint not under $MNT: $1"
}

# A mountpoint to unmount: its parent resolved, its own name taken as given. A filesystem that
# shut down (xfs after a write error, S6) answers even a stat of its root with EIO, so resolving
# the mountpoint itself would refuse the one unmount it needs. The parent may be $MNT itself, as
# a recipe's `mnt/<name>` needs. Narrower than `mnt_path`, which resolves the whole path: the
# name must be a plain word, so a symlinked last component or an `x/..` form is refused.
mnt_target() {
	local path=$1 dir parent name
	while [[ $path == ?*/ ]]; do path=${path%/}; done
	name=${path##*/}
	case $path in */*) dir=${path%/*} ;; *) dir=. ;; esac
	[[ $name =~ ^[A-Za-z0-9._-]+$ && $name != . && $name != .. ]] || die "bad mountpoint: $1"
	parent=$(realpath -e -- "${dir:-/}" 2>/dev/null) || die "mountpoint not under $MNT: $1"
	case $parent in "$MNT" | "$MNT"/?*) ;; *) die "mountpoint not under $MNT: $1" ;; esac
	printf '%s/%s\n' "$parent" "$name"
}

# Literally in the mount table: `findmnt --mountpoint` resolves the path, which a shut-down
# filesystem refuses.
is_mounted() {
	findmnt -rn -o TARGET | grep -qxF -- "$1"
}

# Our mounts (under $MNT), deepest first; with a run, only that run's.
our_mounts() {
	local prefix=$MNT/${1:+$1/}
	findmnt -rn -o TARGET | while read -r m; do
		case $m in "$prefix"*) printf '%s\n' "$m" ;; esac
	done | sort -r
}

# Our device-mapper devices (matched literally); with a run, only that run's.
our_dms() {
	local prefix=st3b-${1:+$1-} n
	dmsetup ls 2>/dev/null | while read -r n _; do
		case $n in "$prefix"?*) printf '%s\n' "$n" ;; esac
	done
}

our_loops() {
	local dev back
	losetup -nO NAME,BACK-FILE | while read -r dev back; do
		back=${back%% (deleted)}
		case $back in "$ROOT/run/${1:+$1/}"*) printf '%s %s\n' "$dev" "$back" ;; esac
	done
}

# Removes one of ours, retrying for up to two minutes while it is busy: a mount namespace with
# private propagation copied while it was mounted (`unshare --mount`, BL-510) holds it until that
# namespace goes.
dm_remove() {
	local deadline=$((SECONDS + 120))
	until dmsetup remove --retry "$1"; do
		[ -b "/dev/mapper/$1" ] || return 1
		[ $SECONDS -lt $deadline ] || return 1
		sleep 2
	done
}

# Resumes each of run $1's devices a killed `dm-swap` left suspended (Opus r1 m5), dropping any
# table it had loaded: an unmount above a suspended device waits in D state for good. A device
# left on a down table stays on it: its writes fail at once, and the image keeps what the fault
# left.
resume_suspended() {
	local d
	for d in $(our_dms "$1"); do
		dmsetup info "$d" 2>/dev/null | grep -q '^State: *SUSPENDED' || continue
		dmsetup clear "$d" || true
		dmsetup resume "$d" || true
	done
}

HOLDERS_LINES=40
# The whole report's time limit, and the mount namespace pass's share of it.
HOLDERS_SECS=120
HOLDERS_NS_SECS=40

# At most $HOLDERS_LINES lines of stdin, then how many more; `none` for no lines.
capped() {
	awk -v cap=$HOLDERS_LINES 'NR <= cap { print }
		END { if (NR > cap) print "... " NR - cap " more"; if (NR == 0) print "none" }'
}

# scan <var> <notes var> <label> <secs> <filter> <command...>: <command>, its stderr with its
# stdout, through the function <filter> into <var>, under the smaller of <secs> and the time left
# before $deadline (holders'). A scan cut short, not run or failing adds a line to <notes var>.
scan() {
	local -n scan_out=$1 scan_notes=$2
	local label=$3 secs=$4 filter=$5 scan_t scan_r scan_rc
	shift 5
	scan_t=$((deadline - SECONDS))
	[ "$scan_t" -le "$secs" ] || scan_t=$secs
	if [ "$scan_t" -le 0 ]; then
		scan_out=""
		scan_notes+="($label not run: cut at the $HOLDERS_SECS s deadline)"$'\n'
		return 0
	fi
	scan_r=$(timeout -k 1 "$scan_t" "$@" 2>&1 | "$filter"; printf '\n@@rc %s' "${PIPESTATUS[0]}")
	scan_rc=${scan_r##*@@rc }
	# shellcheck disable=SC2034 # a nameref: the caller's variable.
	scan_out=${scan_r%$'\n'@@rc *}
	case $scan_rc in
	0 | 1 | 123) ;;
	124 | 137) scan_notes+="($label cut by timeout after $scan_t s)"$'\n' ;;
	*) scan_notes+="($label failed: exit $scan_rc)"$'\n' ;;
	esac
}

# Filters for `scan`; $dev, $majmin and $ids are holders'.
as_is() { cat; }
on_dev() { awk -v dev="$dev" '$1 == "dev" && $2 == dev'; }
maps_on_dev() { awk -v dev="$dev" '/^\/proc\/[0-9]+\/maps$/ { print "dev", dev, $0 }'; }
fds_on_copies() {
	awk -v ids="$ids" 'BEGIN { n = split(ids, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
		$1 ~ /:mnt_id:$/ && $2 in want { sub(/:mnt_id:$/, "", $1); print "mnt", $2, $1 }'
}
fuser_holders() {
	awk 'NR == 1 && / PID / || NF == 1 && /:$/ || $2 $3 == "kernelmount" { next } { print }'
}
loops_on_dev() { awk -v d="$majmin" '$2 == d { print $1, $3 }'; }
swaps_on_dev() { awk -v dev="$dev" '$1 == dev { print $2 }'; }

# find -L over the paths on stdin (NUL-separated), xargs-batched so no list is too long for one
# command: `dev <st_dev> <path>` for each path, or with `fd` for each entry of each path.
FIND_EACH='exec find -L "$@" -maxdepth 0 -printf "dev %D %p\n"'
FIND_IN='exec find -L "$@" -mindepth 1 -maxdepth 1 -printf "dev %D %p\n"'

# The copies of device $majmin in every mount namespace (threads' own included), read through at
# most two pids or threads each, in at most $HOLDERS_NS_SECS s, into $copies as `<mount id>
# <mounts on top> <own> <pid[/tid]> <comm> <mountpoint> <propagation>`, <own> 1 for namespace
# $self; what was cut goes to $ns_notes.
ns_copies() {
	local list ns p base who comm r rc t left read_ns=0 stop
	local -A seen tries
	stop=$((SECONDS + HOLDERS_NS_SECS))
	[ "$stop" -le "$deadline" ] || stop=$deadline
	scan list ns_notes "the namespace list" 30 as_is xargs -0 -r sh -c \
		'exec find "$@" -maxdepth 0 -printf "%l %p\n"' sh \
		< <(printf '%s\0' /proc/[0-9]*/task/[0-9]*/ns/mnt)
	while read -r ns p; do
		[[ $ns == mnt:* ]] || continue
		[ -z "${seen[$ns]:-}" ] && [ "${tries[$ns]:-0}" -lt 2 ] || continue
		t=$((stop - SECONDS))
		if [ "$t" -le 0 ]; then
			left=$(awk '$1 ~ /^mnt:/ { n[$1] } END { print length(n) }' <<<"$list")
			ns_notes+="(namespaces cut at the deadline: $read_ns of $left read)"$'\n'
			break
		fi
		[ "$t" -le 5 ] || t=5
		base=${p%/ns/mnt}
		who=${base#/proc/}
		who=${who%%/*}
		[ "${base##*/}" = "$who" ] || who=$who/${base##*/}
		comm=""
		{ IFS= read -r comm <"$base/comm"; } 2>/dev/null || true
		comm=${comm//[^A-Za-z0-9._-]/?}
		rc=0
		# shellcheck disable=SC2016 # an awk program.
		r=$(WHO="$who ${comm:-?}" timeout -k 1 "$t" awk -v d="$majmin" \
			-v own="$([ "$ns" = "$self" ] && echo 1 || echo 0)" '
			{ top[$2]++ }
			$3 == d {
				prop = ""
				for (i = 7; i <= NF && $i != "-"; i++) prop = prop (prop == "" ? "" : ",") $i
				n++; id[n] = $1; mp[n] = $5; pr[n] = prop == "" ? "private" : prop
			}
			END {
				for (k = 1; k <= n; k++)
					print id[k], top[id[k]] + 0, own, ENVIRON["WHO"], mp[k], pr[k]
			}
		' "$base/mountinfo" 2>/dev/null) || rc=$?
		case $rc in
		0) ;;
		124 | 137) ns_notes+="($ns through $who: mountinfo read cut by timeout after $t s)"$'\n' ;;
		*)
			tries[$ns]=$((${tries[$ns]:-0} + 1))
			continue
			;;
		esac
		seen[$ns]=1
		read_ns=$((read_ns + 1))
		[ -z "$r" ] || copies+=$r$'\n'
	done < <(sort -t/ -k3,3n -k5,5n <<<"$list")
}

# Who holds the filesystem mounted on $1, read-only (BL-762). Every scan runs under `timeout`, each
# bounded on its own and all by $HOLDERS_SECS s in all (the namespace pass by $HOLDERS_NS_SECS s);
# a scan cut short or failing says so in its section. Processes are named by pid (pid/tid for
# threads) and comm only. cwd and root match by st_dev only, which a shut-down xfs hides.
holders() {
	local m=$1 majmin="" d t maj min dev hex self copies="" ids fds="" deadline
	local ns_notes="" fd_notes="" proc_notes="" fuser_notes="" lsof_notes="" loop_notes=""
	local swap_notes="" fuser_out lsof_out pd pf td tf mp loops swaps
	deadline=$((SECONDS + HOLDERS_SECS))
	while read -r d t; do [ "$t" != "$m" ] || majmin=$d; done < <(
		timeout -k 1 10 findmnt -rn -o MAJ:MIN,TARGET || :
	)
	[[ $majmin =~ ^([0-9]{1,9}):([0-9]{1,9})$ ]] || {
		echo "st3b-priv: no device for $m" >&2
		return 2
	}
	maj=${BASH_REMATCH[1]} min=${BASH_REMATCH[2]}
	dev=$((((maj & 0xfffff000) << 32) | ((maj & 0xfff) << 8) |
		((min & 0xffffff00) << 12) | (min & 0xff)))
	hex=$(printf '%02x:%02x' "$maj" "$min")
	self=$(timeout -k 1 5 find "/proc/$$/ns/mnt" -maxdepth 0 -printf '%l' 2>/dev/null) || :

	ns_copies
	ids=$(awk '{ printf "%s ", $1 }' <<<"$copies")
	# Every fd on one of those copies by its mount ID, which a shut-down filesystem's EIO on stat
	# does not hide: `mnt <id> <fdinfo path>`.
	scan fds fd_notes "the fdinfo scan" 60 fds_on_copies xargs -0 -r grep -rHs '^mnt_id:' \
		< <(printf '%s\0' /proc/[0-9]*/fdinfo /proc/[0-9]*/task/[0-9]*/fdinfo)
	ns_notes+=$fd_notes
	proc_notes+=$fd_notes
	scan pd proc_notes "the cwd/root/exe scan" 30 on_dev xargs -0 -r sh -c "$FIND_EACH" sh \
		< <(printf '%s\0' /proc/[0-9]*/cwd /proc/[0-9]*/root /proc/[0-9]*/exe)
	scan pf proc_notes "the fd scan" 30 on_dev xargs -0 -r sh -c "$FIND_IN" sh \
		< <(printf '%s\0' /proc/[0-9]*/fd)
	scan td proc_notes "the thread cwd/root scan" 60 on_dev xargs -0 -r sh -c "$FIND_EACH" sh \
		< <(printf '%s\0' /proc/[0-9]*/task/[0-9]*/cwd /proc/[0-9]*/task/[0-9]*/root)
	scan tf proc_notes "the thread fd scan" 60 on_dev xargs -0 -r sh -c "$FIND_IN" sh \
		< <(printf '%s\0' /proc/[0-9]*/task/[0-9]*/fd)
	scan mp proc_notes "the maps scan" 30 maps_on_dev xargs -0 -r grep -lE \
		"^[^ ]+ [^ ]+ [^ ]+ $hex " < <(printf '%s\0' /proc/[0-9]*/maps)
	scan fuser_out fuser_notes fuser 10 fuser_holders fuser -vm "$m"
	scan lsof_out lsof_notes lsof 20 as_is lsof -w +f -- "$m"
	scan loops loop_notes losetup 10 loops_on_dev losetup -nO NAME,BACK-MAJ:MIN,BACK-FILE
	scan swaps swap_notes "the swap scan" 10 swaps_on_dev xargs -0 -r sh -c \
		'exec find -L "$@" -maxdepth 0 -printf "%D %p\n"' sh \
		< <(awk 'NR > 1 { printf "%s%c", $1, 0 }' /proc/swaps)

	echo "holders of $m (device $majmin)"
	echo "== fuser -vm"
	printf '%s' "$fuser_notes"
	printf '%s' "$fuser_out" | capped
	echo "== lsof +f"
	printf '%s' "$lsof_notes"
	printf '%s' "$lsof_out" | capped
	echo "== /proc: pid[/tid] comm link:match (dev: st_dev, mnt: fdinfo mount ID)"
	printf '%s' "$proc_notes"
	printf '%s\n' "$pd" "$pf" "$td" "$tf" "$mp" "$fds" | awk '$1 == "dev" || $1 == "mnt" {
			n = split($3, f, "/")
			p = f[3]; t = p; i = 4
			if (f[4] == "task") { t = f[5]; i = 6 }
			l = f[i] == "fdinfo" ? "fd" : f[i]
			if (i < n) l = l "/" f[i + 1]
			print p, t, l, $1
		}' |
		sort -k1,1n -k2,2n -k3,3 -k4,4 -u |
		awk '{
			k = $1 SUBSEP $2 SUBSEP $3
			if (k in how) how[k] = how[k] "+" $4; else { key[++n] = k; how[k] = $4 }
			if ($1 == $2) proc[$1, $3] = 1
		}
		END {
			for (i = 1; i <= n; i++) {
				split(key[i], f, SUBSEP)
				if (f[2] != f[1] && (f[1], f[3]) in proc) continue
				w = f[1] SUBSEP f[2]
				if (!(w in c)) who[++m] = w
				if (++c[w] <= 10) links[w] = links[w] (c[w] > 1 ? "," : "") f[3] ":" how[key[i]]
				else if (c[w] == 11) links[w] = links[w] ",..."
			}
			# Threads of one process with the same links (its main thread gone) share a line.
			for (j = 1; j <= m; j++) {
				split(who[j], f, SUBSEP)
				g = f[1] == f[2] ? who[j] : f[1] SUBSEP "t" SUBSEP links[who[j]]
				if (!(g in tids)) { out[++o] = g; pid[g] = f[1]; ln[g] = links[who[j]] }
				if (f[1] == f[2]) continue
				if (++nt[g] <= 8) tids[g] = tids[g] (nt[g] > 1 ? "," : "/") f[2]
				else if (nt[g] == 9) tids[g] = tids[g] ",..."
			}
			for (k = 1; k <= o; k++) print pid[out[k]] tids[out[k]], ln[out[k]]
		}' |
		while read -r d t; do
			p=${d%%/*}
			r=${d#*/}
			comm=""
			{ IFS= read -r comm <"/proc/$p/task/${r%%,*}/comm"; } 2>/dev/null || true
			comm=${comm//[^A-Za-z0-9._-]/?}
			printf '%s %s %s\n' "$d" "${comm:-?}" "$t"
		done | capped
	echo "== loop devices backed on the device"
	printf '%s' "$loop_notes"
	printf '%s' "$loops" | capped
	echo "== swap files on the device"
	printf '%s' "$swap_notes"
	printf '%s' "$swaps" | capped
	# Busiest first, so the cap cuts only idle copies: ours, then by mounts on top plus pids with
	# fds on the copy. Our own idle copy at <mnt> is the mount itself, so it is left out.
	echo "== mount namespaces: pid[/tid] comm mountpoint propagation on-top <n> fd-pids <n> [own]"
	printf '%s' "$ns_notes"
	awk -v m="$m" 'FNR == NR {
			if ($1 == "mnt" && split($3, f, "/") && !(($2, f[3]) in seen)) {
				seen[$2, f[3]]
				pids[$2]++
			}
			next
		}
		NF {
			fp = pids[$1] + 0
			if ($3 && $6 == m && $2 == 0 && fp == 0) next
			print 1 - $3, $2 + fp, $4, $5, $6, $7, "on-top", $2, "fd-pids", fp ($3 ? " own" : "")
		}' <(printf '%s\n' "$fds") <(printf '%s\n' "$copies") |
		sort -k1,1n -k2,2nr -k3,3n | cut -d' ' -f3- | capped
}

leaks() {
	our_mounts "${1:-}" | sed 's/^/mount /'
	our_dms "${1:-}" | sed 's/^/dm /'
	our_loops "${1:-}" | sed 's/^/loop /'
}

verb=${1:-}
[ $# -gt 0 ] && shift
case $verb in
losetup-attach)
	[ $# = 1 ] || die "losetup-attach <file>"
	f=$(under "$ROOT/run" "$1") || die "not a file under $ROOT/run: $1"
	[ -f "$f" ] || die "not a regular file: $f"
	losetup --find --show -- "$f"
	;;
losetup-detach)
	[ $# = 1 ] || die "losetup-detach /dev/loopN"
	our_loop "$1" || die "not one of our loop devices: $1"
	losetup -d "$1"
	;;
dm-create)
	[ $# = 2 ] || die "dm-create <name> <table>"
	dm_name "$1"
	check_table "$2"
	dmsetup create "$1" --table "$2"
	;;
dm-swap)
	[ $# -ge 2 ] || die "dm-swap <name> <segment>..."
	dm_name "$1"
	name=$1
	shift
	[ -b "/dev/mapper/$name" ] || die "no such device: $name"
	check_segments "$(blockdev --getsz "/dev/mapper/$name")" "$@"
	dmsetup suspend --nolockfs "$name"
	if ! printf '%s\n' "$@" | dmsetup load "$name"; then
		dmsetup resume "$name" || true
		die "load failed: $name"
	fi
	# The kernel checks a table's device areas at the resume: a refused one is dropped, and the
	# device stays suspended on its old table until resumed again.
	if ! dmsetup resume "$name"; then
		dmsetup resume "$name" || true
		die "resume failed: $name"
	fi
	set_stable_writes "$name"
	;;
stable-writes)
	[ $# = 1 ] || die "stable-writes <name>"
	dm_name "$1"
	set_stable_writes "$1"
	;;
dm-remove)
	[ $# = 1 ] || die "dm-remove <name>"
	dm_name "$1"
	dm_remove "$1"
	;;
dm-message)
	[ $# = 3 ] && [ "$2" = mark ] || die "dm-message <name> mark <word>"
	dm_name "$1"
	[[ $3 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "bad mark: $3"
	dmsetup message "$1" 0 mark "$3"
	;;
mkfs)
	[ $# = 2 ] || die "mkfs <dev> ext4|xfs"
	our_dev "$1" || die "device not ours: $1"
	case $2 in
	ext4) mkfs.ext4 -q -F -E nodiscard,lazy_itable_init=0,lazy_journal_init=0 -- "$1" ;;
	xfs) mkfs.xfs -q -f -K -- "$1" ;;
	*) die "fs not allowed: $2" ;;
	esac
	;;
mount)
	[ $# = 3 ] || [ $# = 4 ] || die "mount <dev> <mnt> ext4|xfs [ro]"
	our_dev "$1" || die "device not ours: $1"
	m=$(mnt_path "$2")
	is_mounted "$m" && die "already mounted: $m"
	opts=nodiscard,nodev,nosuid,noexec
	case $3 in ext4) opts=$opts,errors=continue ;; xfs) opts=$opts,nouuid ;; *) die "fs not allowed: $3" ;; esac
	case ${4:-rw} in ro | rw) opts=$opts,${4:-rw} ;; *) die "option not allowed: $4" ;; esac
	mount -t "$3" -o "$opts" -- "$1" "$m"
	;;
umount)
	[ $# = 1 ] || die "umount <mnt>"
	m=$(mnt_target "$1")
	is_mounted "$m" || die "not mounted: $m"
	umount -- "$m"
	;;
holders)
	[ $# = 1 ] || die "holders <mnt>"
	m=$(mnt_target "$1")
	is_mounted "$m" || die "not mounted: $m"
	holders "$m"
	;;
chown-mnt)
	[ $# = 1 ] || die "chown-mnt <mnt>"
	m=$(mnt_path "$1")
	is_mounted "$m" || die "not mounted: $m"
	[[ ${SUDO_UID:-} =~ ^[0-9]+$ && ${SUDO_GID:-} =~ ^[0-9]+$ ]] || die "no SUDO_UID/SUDO_GID"
	chown "$SUDO_UID:$SUDO_GID" -- "$m"
	chmod 0700 -- "$m"
	;;
sweep)
	[ $# = 1 ] || die "sweep <run>"
	run_id "$1"
	# Held for the whole sweep: a live run, or another sweep of the same run, keeps its hands off.
	lock=$ROOT/run/$1/lock
	if [ -e "$lock" ]; then
		exec 9<"$lock"
		flock -n 9 || {
			echo "st3b-priv: run $1 is live (its lock is held)" >&2
			exit 3
		}
	elif [ ! -d "$ROOT/run/$1" ] && [ -n "$(leaks "$1")" ]; then
		# No lock to test: a live run whose directory was pruned under it looks just like this.
		echo "st3b-priv: run $1 has devices or mounts but no run directory; not sweeping it" >&2
		exit 4
	fi
	resume_suspended "$1"
	while read -r m; do
		[ -n "$m" ] || continue
		umount -- "$m" || holders "$m" </dev/null >&2 || true
	done < <(our_mounts "$1")
	# A device still opened by another of ours fails until that one goes, and one held by a mount
	# namespace until the namespace goes: pass over them until none is left, for up to two minutes
	# (dm_remove's bound).
	deadline=$((SECONDS + 120))
	while left=$(our_dms "$1") && [ -n "$left" ]; do
		for d in $left; do dmsetup remove --retry "$d" 2>/dev/null || true; done
		[ -n "$(our_dms "$1")" ] && [ $SECONDS -lt $deadline ] || break
		sleep 2
	done
	while read -r dev _; do
		[ -n "$dev" ] || continue
		losetup -d "$dev" || true
	done < <(our_loops "$1")
	# Only what is still there counts as a failure.
	left=$(leaks "$1")
	if [ -n "$left" ]; then
		echo "st3b-priv: run $1 still has:" >&2
		echo "$left" >&2
		exit 1
	fi
	echo "swept $1 ($([ -e "$lock" ] && echo "lock free" || echo "no lock file"))"
	;;
kernel)
	[ $# = 1 ] || die "kernel <dest>"
	name=${1##*/}
	[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ ]] || die "bad file name: $1"
	parent=$(realpath -e -- "$(dirname -- "$1")" 2>/dev/null) || die "no directory for $1"
	case $parent in "$ROOT/vm" | "$ROOT/vm"/*) ;; *) die "not under $ROOT/vm: $1" ;; esac
	dest=$parent/$name
	[ ! -e "$dest" ] && [ ! -L "$dest" ] || die "already there: $dest"
	[[ ${SUDO_UID:-} =~ ^[0-9]+$ && ${SUDO_GID:-} =~ ^[0-9]+$ ]] || die "no SUDO_UID/SUDO_GID"
	# Root running sudo would write as root, following a path swapped after the checks.
	[ "$SUDO_UID" != 0 ] || die "kernel is for a user's sudo, not root's"
	src=/boot/vmlinuz-$(uname -r)
	[ -f "$src" ] || die "no $src"
	# Root only reads /boot, and never opens, compares or hashes a path under the user's directory
	# (S7 r1 #1, r2 N1): it hashes the source, and the invoking user creates the copy, makes it
	# 0444 and checks its hash against root's, so a path swapped after the checks gets nothing the
	# user could not write anyway. The copy goes to a new file beside <dest> (created exclusively,
	# removed whatever happens after) and is linked into place only whole and verified, so a failed
	# copy leaves no truncated kernel behind (S7 r1 m5); `ln` refuses a <dest> that appeared
	# meanwhile.
	want=$(sha256sum <"$src" | cut -d' ' -f1)
	[[ $want =~ ^[0-9a-f]{64}$ ]] || die "hashing $src failed"
	tmp=$dest.tmp.$$
	# shellcheck disable=SC2016 # $1, $2 and $3 are the inner shell's.
	setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --clear-groups -- \
		sh -c 'umask 077 && set -C && : >"$1" || exit 1
			cat >>"$1" && chmod 0444 "$1" &&
				[ "$(sha256sum <"$1" | cut -d" " -f1)" = "$3" ] && ln -- "$1" "$2"
			s=$?; rm -f -- "$1"; exit $s' \
		sh "$tmp" "$dest" "$want" <"$src" ||
		die "writing $dest failed (or its copy differs from $src)"
	printf '%s  %s\n' "$want" "$dest"
	;;
leaks)
	[ $# -le 1 ] || die "leaks [<run>]"
	[ $# = 0 ] || run_id "$1"
	leaks "${1:-}"
	;;
*)
	die "unknown verb: ${verb:-<none>} (see the header)"
	;;
esac
