[Unit]
Description=ST3b VM-level power-loss weekly: KVM guest kills, C1-C4 (PLAN-ST3b-S7 §2.4)
# A deferred week (exit 75: too little disk, or load) is tried again every 2 h, at most 6 starts
# a day; then the unit fails and the ledger's DEFERRED rows show the skipped week (S7 r1 m9).
StartLimitIntervalSec=1d
StartLimitBurst=6

# A template: S8 installs it (install-units.sh copies every unit here, and the drop-ins). The
# driver: it builds release rdashd and st3b-crash once, in its own checkout and target, with the
# guest and image (weekly-vm.sh --prepare), then starts each component as its own
# st3b-vm-weekly@<component>.service in turn, each with its own timeout and record, and ends with
# the week's leak check and DONE (S7 r1 M2). Set up /work/scratch/st3b/weekly-vm/checkout first: a
# worktree of the primary repository, which `ExecStartPre` detaches at the node/integration tip
# (a local branch that TRAINS moves; nothing to fetch) each week.
[Service]
Type=oneshot
Environment=TMPDIR=/work/scratch/st3b/tmp
Environment=CARGO_BUILD_JOBS=8
WorkingDirectory=/work/scratch/st3b/weekly-vm
ExecStartPre=/usr/bin/git -C checkout checkout --quiet --detach node/integration
# One output directory per day (the guest is built in it).
ExecStart=/bin/bash -c 'exec ./checkout/contrib/node/crash/weekly-vm.sh --units "/work/scratch/st3b/weekly-vm/out/$(date -u +%%Y%%m%%d)"'
RestartForceExitStatus=75
RestartSec=2h
Nice=19
IOSchedulingClass=idle
CPUWeight=25
MemoryMax=16G
# The build (at most 3 h, `timeout` in weekly-vm.sh) and the components' own units in turn, each
# bounded by its drop-in: 6 x 6 h (W-40k, provisional, S7 r2 N7) + 6000 + 2400 s (v-reorg) + 10 min
# (v-reindex), up to 10 min more each for the guest lock, plus the guest, image and leak check:
# about 45 h, so a finite cap of 48 h (S7 r2 N-b). S8 lowers it with the drop-ins.
TimeoutStartSec=48h
