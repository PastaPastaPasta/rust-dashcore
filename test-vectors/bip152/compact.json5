BOOST_AUTO_TEST_CASE(compact_block_payloads)
{
    // Testnet block 0000000c19cb9d0928ccf448d50a62605e0539d0450e34d7d6d16a6c032be53f at height 1592894, the cmpctblock reply to getdata.
    constexpr char CMPCTBLOCK_1592894[] =
        "";
    // Testnet block 000000a7d51270cdd8ba9080312cd9880889cf3417ca07c025a0382acf0db110 at height 1592891, the cmpctblock reply to getdata.
    constexpr char CMPCTBLOCK_1592891[] =
        "";
    // The getblocktxn sent for every transaction the cmpctblock for block 1592894 left out.
    constexpr char GETBLOCKTXN_1592894[] =
        "3fe52b036c6ad1d6d7340e45d039055e60620ad548f4cc28099dcb190c00000006010000000000";
    // The getblocktxn sent for every transaction the cmpctblock for block 1592891 left out.
    constexpr char GETBLOCKTXN_1592891[] =
        "10b10dcf2a38a025c007ca1734cf890888d92c318090bad8cd7012d5a700000003010000";
    // The blocktxn reply to that getblocktxn.
    constexpr char BLOCKTXN_1592894[] =
        "";
    // The blocktxn reply to that getblocktxn.
    constexpr char BLOCKTXN_1592891[] =
        "";
    struct CmpctBlock : CBlockHeaderAndShortTxIDs {
        using CBlockHeaderAndShortTxIDs::prefilledtxn;
        using CBlockHeaderAndShortTxIDs::shorttxids;
    };
    const auto read = [](auto& value, const char* raw) {
        DataStream input{ParseHex(raw)};
        input >> value;
        BOOST_REQUIRE(input.empty());
        DataStream output{};
        output << value;
        BOOST_REQUIRE_EQUAL(HexStr(output), raw);
    };
    const auto tx_json = [](const CTransaction& tx) {
        std::string inputs, outputs;
        for (const auto& in : tx.vin) {
            inputs += strprintf("%s{\"prevout\": {\"hash\": \"%s\", \"index\": %u}, \"scriptSig\": \"%s\", \"sequence\": %u}",
                                inputs.empty() ? "" : ", ", in.prevout.hash.ToString(), in.prevout.n, HexStr(in.scriptSig), in.nSequence);
        }
        for (const auto& out : tx.vout) {
            outputs += strprintf("%s{\"value\": %d, \"scriptPubKey\": \"%s\"}", outputs.empty() ? "" : ", ", out.nValue, HexStr(out.scriptPubKey));
        }
        return strprintf("{\"version\": %d, \"txType\": %u, \"inputs\": [%s], \"outputs\": [%s], \"lockTime\": %u, \"extraPayload\": \"%s\"}",
                         tx.nVersion, tx.nType, inputs, outputs, tx.nLockTime, HexStr(tx.vExtraPayload));
    };
    const auto row = [](const std::string& comment, const std::string& label, const std::string& raw, const std::string& details) {
        std::printf("    // %s\n    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": %s\n    },\n",
                    comment.c_str(), label.c_str(), raw.c_str(), details.c_str());
    };
    const std::vector<std::pair<int, const char*>> cmpctblocks{
        {1592894, CMPCTBLOCK_1592894}, {1592891, CMPCTBLOCK_1592891}};
    const std::vector<std::pair<int, const char*>> getblocktxns{
        {1592894, GETBLOCKTXN_1592894}, {1592891, GETBLOCKTXN_1592891}};
    const std::vector<std::pair<int, const char*>> blocktxns{{1592894, BLOCKTXN_1592894}, {1592891, BLOCKTXN_1592891}};

    std::vector<std::pair<int, CmpctBlock>> blocks;
    for (const auto& [height, raw] : cmpctblocks) {
        read(blocks.emplace_back(height, CmpctBlock{}).second, raw);
    }
    std::printf("  \"cmpctblock\": {\n");
    for (size_t i = 0; i < blocks.size(); ++i) {
        const auto& [height, block] = blocks[i];
        DataStream fields{ParseHex(cmpctblocks[i].second)};
        CBlockHeader header;
        uint64_t nonce;
        fields >> header >> nonce;
        std::string short_ids, prefilled;
        for (const auto id : block.shorttxids) {
            DataStream bytes{};
            bytes << Using<CustomUintFormatter<CBlockHeaderAndShortTxIDs::SHORTTXIDS_LENGTH>>(id);
            short_ids += strprintf("%s{\"bytes\": \"%s\"}", short_ids.empty() ? "" : ", ", HexStr(bytes));
        }
        for (const auto& entry : block.prefilledtxn) {
            prefilled += strprintf("%s{\"idx\": %u, \"tx\": %s}", prefilled.empty() ? "" : ", ", entry.index, tx_json(*entry.tx));
        }
        row(strprintf("Testnet block %d, %u short IDs and %u prefilled transaction.", height, block.shorttxids.size(), block.prefilledtxn.size()),
            strprintf("testnet_%d", height), cmpctblocks[i].second,
            strprintf("{\"header\": {\"version\": %d, \"prevHash\": \"%s\", \"merkleRoot\": \"%s\", \"time\": %u, \"bits\": %u, \"nonce\": %u}, "
                      "\"nonce\": \"%u\", \"short_ids\": [%s], \"prefilled_txs\": [%s]}",
                      header.nVersion, header.hashPrevBlock.ToString(), header.hashMerkleRoot.ToString(), header.nTime, header.nBits,
                      header.nNonce, nonce, short_ids, prefilled));
    }
    std::printf("  },\n");

    std::printf("  \"getblocktxn\": {\n");
    for (const auto& [height, raw] : getblocktxns) {
        BlockTransactionsRequest req;
        read(req, raw);
        std::string indexes;
        for (const auto index : req.indexes) indexes += strprintf("%s%u", indexes.empty() ? "" : ", ", index);
        row(strprintf("Request for the %u transactions the cmpctblock for testnet block %d left out.", req.indexes.size(), height),
            strprintf("testnet_%d", height), raw, strprintf("{\"block_hash\": \"%s\", \"indexes\": [%s]}", req.blockhash.ToString(), indexes));
    }
    std::printf("  },\n");

    std::printf("  \"blocktxn\": {\n");
    for (const auto& [height, raw] : blocktxns) {
        BlockTransactions txn;
        read(txn, raw);
        std::string transactions;
        for (const auto& tx : txn.txn) transactions += strprintf("%s%s", transactions.empty() ? "" : ", ", tx_json(*tx));
        row(strprintf("Reply with the %u transactions requested for testnet block %d.", txn.txn.size(), height),
            strprintf("testnet_%d", height), raw, strprintf("{\"block_hash\": \"%s\", \"transactions\": [%s]}", txn.blockhash.ToString(), transactions));
    }
    std::printf("  },\n");
}
