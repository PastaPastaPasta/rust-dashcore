+// Copyright (c) 2026 The Dash Core developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Node-program task O4: audit of the flag-perturbation checks in Core's script and transaction
+// test harnesses (transaction_tests.cpp, script_tests.cpp), run against Core's own interpreter.
+//
+// Core's harness checks that a passing vector keeps passing when flags are removed and a failing
+// one keeps failing when flags are added. Its loops have three defects (see PROVENANCE.md of the
+// vector set): they only perturb `1 << i` for i < 13, which skips NULLFAIL (bit 14) and
+// CONST_SCRIPTCODE (bit 16); `ExcludeIndividualFlags` returns nothing, so the "flags are maximal /
+// minimal" checks never run; and tx_valid hands the verifier all 32 bits of `~flags`.
+//
+// This test repeats the checks the way the harness intends them, over every defined flag, and
+// writes the violations it finds to $O4_VECTOR_OUT/harness_audit.json. It asserts nothing about
+// them: the file is what the Rust loaders' documentation relies on. Inert unless O4_VECTOR_OUT is
+// set.
+
+#include <test/data/script_tests.json.h>
+#include <test/data/tx_invalid.json.h>
+#include <test/data/tx_valid.json.h>
+
+#include <test/util/json.h>
+#include <test/util/o4_dump.h>
+#include <test/util/setup_common.h>
+#include <test/util/transaction_utils.h>
+
+#include <consensus/tx_check.h>
+#include <consensus/validation.h>
+#include <core_io.h>
+#include <script/interpreter.h>
+#include <script/script.h>
+#include <script/script_error.h>
+#include <streams.h>
+#include <util/string.h>
+#include <util/strencodings.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <univalue.h>
+
+#include <algorithm>
+#include <map>
+#include <string>
+#include <vector>
+
+BOOST_FIXTURE_TEST_SUITE(o4_harness_audit_tests, BasicTestingSetup)
+
+namespace {
+// mapFlagNames of transaction_tests.cpp.
+const std::map<std::string, unsigned int> FLAG_NAMES = {
+    {"P2SH", SCRIPT_VERIFY_P2SH},
+    {"STRICTENC", SCRIPT_VERIFY_STRICTENC},
+    {"DERSIG", SCRIPT_VERIFY_DERSIG},
+    {"LOW_S", SCRIPT_VERIFY_LOW_S},
+    {"SIGPUSHONLY", SCRIPT_VERIFY_SIGPUSHONLY},
+    {"MINIMALDATA", SCRIPT_VERIFY_MINIMALDATA},
+    {"NULLDUMMY", SCRIPT_VERIFY_NULLDUMMY},
+    {"DISCOURAGE_UPGRADABLE_NOPS", SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_NOPS},
+    {"CLEANSTACK", SCRIPT_VERIFY_CLEANSTACK},
+    {"NULLFAIL", SCRIPT_VERIFY_NULLFAIL},
+    {"CHECKLOCKTIMEVERIFY", SCRIPT_VERIFY_CHECKLOCKTIMEVERIFY},
+    {"CHECKSEQUENCEVERIFY", SCRIPT_VERIFY_CHECKSEQUENCEVERIFY},
+    {"CONST_SCRIPTCODE", SCRIPT_VERIFY_CONST_SCRIPTCODE},
+};
+
+unsigned int DefinedFlags()
+{
+    unsigned int m = 0;
+    for (const auto& [name, bit] : FLAG_NAMES) m |= bit;
+    return m;
+}
+
+unsigned int ParseFlags(const std::string& s)
+{
+    if (s.empty() || s == "NONE") return 0;
+    unsigned int flags = 0;
+    for (const std::string& word : SplitString(s, ',')) flags |= FLAG_NAMES.at(word);
+    return flags;
+}
+
+std::string FlagString(unsigned int flags)
+{
+    std::string out;
+    for (const auto& [name, bit] : FLAG_NAMES) {
+        if (flags & bit) out += (out.empty() ? "" : ",") + name;
+    }
+    return out.empty() ? "NONE" : out;
+}
+
+unsigned int Trim(unsigned int flags)
+{
+    return (flags & SCRIPT_VERIFY_P2SH) ? flags : flags & ~(unsigned int)SCRIPT_VERIFY_CLEANSTACK;
+}
+unsigned int Fill(unsigned int flags)
+{
+    return (flags & SCRIPT_VERIFY_CLEANSTACK) ? flags | SCRIPT_VERIFY_P2SH : flags;
+}
+
+std::vector<unsigned int> DefinedBits()
+{
+    std::vector<unsigned int> bits;
+    for (const auto& [name, bit] : FLAG_NAMES) bits.push_back(bit);
+    std::sort(bits.begin(), bits.end());
+    return bits;
+}
+
+// ExcludeIndividualFlags as intended, for a set of *enabled* flags: each defined flag removed in
+// turn, trimmed to a valid combination (the original tests `find(..) != end()`). Used for
+// tx_invalid, where the listed flags are the enabled ones.
+std::vector<unsigned int> ExcludeIndividual(unsigned int flags)
+{
+    std::vector<unsigned int> combos;
+    for (unsigned int bit : DefinedBits()) {
+        const unsigned int excluded = Trim(flags & ~bit);
+        if (flags != excluded && std::find(combos.begin(), combos.end(), excluded) == combos.end()) combos.push_back(excluded);
+    }
+    return combos;
+}
+
+// A fixed LCG so that the audit is reproducible.
+struct Rng {
+    uint64_t state{0x4f34ULL};
+    uint32_t Next()
+    {
+        const uint32_t ret = state >> 32;
+        state = state * 6364136223846793005ULL + 1442695040888963407ULL;
+        return ret;
+    }
+};
+
+constexpr int RANDOM_SETS = 128;
+
+struct Tally {
+    int64_t cases{0};
+    int64_t checks{0};
+    UniValue violations{UniValue::VARR};
+
+    void Violation(const char* check, size_t index, unsigned int flags, const std::string& observed)
+    {
+        violations.push_back(o4::Obj({{"check", check}, {"row", int64_t(index)}, {"flags", FlagString(flags)}, {"observed", observed}}));
+    }
+    UniValue ToJson() const
+    {
+        return o4::Obj({{"cases", cases}, {"checks", checks}, {"violation_count", int64_t(violations.size())}, {"violations", violations}});
+    }
+};
+
+bool VerifyCredit(const CScript& sig, const CScript& pub, unsigned int flags, ScriptError& err)
+{
+    const CTransaction credit{BuildCreditingTransaction(pub)};
+    const CMutableTransaction tx = BuildSpendingTransaction(sig, credit);
+    return VerifyScript(sig, pub, flags, MutableTransactionSignatureChecker(&tx, 0, credit.vout[0].nValue, MissingDataBehavior::ASSERT_FAIL), &err);
+}
+
+bool VerifyTx(const CTransaction& tx, const std::map<COutPoint, CScript>& prevouts, unsigned int flags, const PrecomputedTransactionData& txdata, ScriptError& err)
+{
+    for (unsigned int i = 0; i < tx.vin.size(); ++i) {
+        if (!VerifyScript(tx.vin[i].scriptSig, prevouts.at(tx.vin[i].prevout), flags,
+                          TransactionSignatureChecker(&tx, i, /*amount=*/0, txdata, MissingDataBehavior::ASSERT_FAIL), &err)) {
+            return false;
+        }
+    }
+    err = SCRIPT_ERR_OK;
+    return true;
+}
+} // namespace
+
+BOOST_AUTO_TEST_CASE(o4_audit_flag_perturbation)
+{
+    if (!o4::Dump::Get().Enabled()) return;
+    const std::vector<unsigned int> bits = DefinedBits();
+    const unsigned int defined = DefinedFlags();
+
+    // ---- script_tests.json -------------------------------------------------------------------
+    Tally script_tally;
+    {
+        const UniValue tests = read_json(std::string(json_tests::script_tests, json_tests::script_tests + sizeof(json_tests::script_tests)));
+        Rng rng;
+        for (size_t idx = 0; idx < tests.size(); ++idx) {
+            const UniValue& test = tests[idx];
+            if (test.size() < 4) continue;
+            const CScript sig = ParseScript(test[0].get_str());
+            const CScript pub = ParseScript(test[1].get_str());
+            const unsigned int flags = ParseFlags(test[2].get_str());
+            ScriptError err;
+            const bool expect = VerifyCredit(sig, pub, flags, err);
+            ++script_tally.cases;
+
+            std::vector<unsigned int> sets;
+            for (unsigned int bit : bits) sets.push_back(expect ? Trim(flags & ~bit) : Fill(flags | bit));
+            for (int i = 0; i < RANDOM_SETS; ++i) {
+                const unsigned int extra = rng.Next() & defined;
+                sets.push_back(expect ? Trim(flags & ~extra) : Fill(flags | extra));
+            }
+            for (unsigned int s : sets) {
+                ++script_tally.checks;
+                ScriptError e;
+                if (VerifyCredit(sig, pub, s, e) != expect) script_tally.Violation(expect ? "valid_then_invalid_with_flags_removed" : "invalid_then_valid_with_flags_added", idx, s, o4::ScriptErrorName(e));
+            }
+        }
+    }
+
+    // ---- tx_valid.json / tx_invalid.json -----------------------------------------------------
+    const auto run_tx_file = [&](const unsigned char* begin, size_t size, bool valid_file) {
+        Tally tally;
+        const UniValue tests = read_json(std::string(begin, begin + size));
+        Rng rng;
+        for (size_t idx = 0; idx < tests.size(); ++idx) {
+            const UniValue& test = tests[idx];
+            if (!test[0].isArray()) continue;
+            std::map<COutPoint, CScript> prevouts;
+            for (const UniValue& input : test[0].get_array().getValues()) {
+                prevouts[COutPoint{uint256S(input[0].get_str()), uint32_t(input[1].getInt<int>())}] = ParseScript(input[2].get_str());
+            }
+            CDataStream stream(ParseHex(test[1].get_str()), SER_NETWORK, PROTOCOL_VERSION);
+            CTransaction tx(deserialize, stream);
+            TxValidationState state;
+            const bool check_ok = CheckTransaction(tx, state) && state.IsValid();
+            if (!valid_file && (!check_ok)) {
+                BOOST_CHECK_EQUAL(test[2].get_str(), "BADTX");
+                continue;
+            }
+            ++tally.cases;
+            PrecomputedTransactionData txdata(tx);
+            const unsigned int listed = ParseFlags(test[2].get_str());
+            ScriptError e;
+            const auto check = [&](const char* name, unsigned int flags, bool want) {
+                ++tally.checks;
+                const bool got = VerifyTx(tx, prevouts, flags, txdata, e);
+                if (got != want) tally.Violation(name, idx, flags, o4::ScriptErrorName(e));
+            };
+
+            if (valid_file) {
+                // `listed` are the excluded flags: all others must pass.
+                const unsigned int base = defined & ~listed;
+                check("valid_with_all_but_excluded_flags", Trim(base), true);
+                for (unsigned int bit : bits) check("valid_with_one_more_flag_removed", Trim(base & ~bit), true);
+                for (int i = 0; i < RANDOM_SETS; ++i) check("valid_with_random_flags_removed", Trim(base & ~(rng.Next() & defined)), true);
+                // The excluded flags are maximal: switching any one of them back on (CLEANSTACK
+                // together with P2SH, which it needs) must make the transaction fail. The
+                // CLEANSTACK-needs-P2SH rule applies to the enabled flags, so it is applied there.
+                for (unsigned int bit : bits) {
+                    if (!(listed & bit)) continue;
+                    check("excluded_flag_is_needed", Fill(base | bit), false);
+                }
+            } else {
+                check("invalid_with_listed_flags", listed, false);
+                for (unsigned int bit : bits) check("invalid_with_one_more_flag_added", Fill(listed | bit), false);
+                for (int i = 0; i < RANDOM_SETS; ++i) check("invalid_with_random_flags_added", Fill(listed | (rng.Next() & defined)), false);
+                // The listed flags are minimal: dropping any one of them must make it pass.
+                for (unsigned int s : ExcludeIndividual(listed)) check("listed_flag_is_needed", s, true);
+            }
+        }
+        return tally;
+    };
+    const Tally valid_tally = run_tx_file(json_tests::tx_valid, sizeof(json_tests::tx_valid), true);
+    const Tally invalid_tally = run_tx_file(json_tests::tx_invalid, sizeof(json_tests::tx_invalid), false);
+
+    O4_RECORD("harness_audit",
+              o4::Obj({{"defined_flags", FlagString(defined)},
+                       {"random_sets_per_case", RANDOM_SETS},
+                       {"script_tests", script_tally.ToJson()},
+                       {"tx_valid", valid_tally.ToJson()},
+                       {"tx_invalid", invalid_tally.ToJson()}}));
+}
+
+BOOST_AUTO_TEST_SUITE_END()
