+namespace {
+bool Env(const char* name, std::string& out)
+{
+    const char* v = std::getenv(name);
+    if (v == nullptr || *v == '\0') return false;
+    out = v;
+    return true;
+}
+
+std::vector<unsigned char> ReadFile(const std::string& path)
+{
+    std::ifstream f(path, std::ios::binary);
+    BOOST_REQUIRE_MESSAGE(f.good(), "cannot open " + path);
+    return {std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>()};
+}
+
+UniValue ReadManifest(const std::string& path)
+{
+    const std::vector<unsigned char> bytes = ReadFile(path);
+    return read_json(std::string(bytes.begin(), bytes.end()));
+}
+
+// Short values on one line, everything else one member per line, so that the files diff well.
+void Pretty(const UniValue& v, size_t indent, std::string& out)
+{
+    const std::string compact = v.write();
+    if (compact.size() <= 180 || (!v.isArray() && !v.isObject())) {
+        out += compact;
+        return;
+    }
+    const std::string pad(indent + 2, ' ');
+    if (v.isArray()) {
+        out += "[\n";
+        for (size_t i = 0; i < v.size(); ++i) {
+            out += pad;
+            Pretty(v[i], indent + 2, out);
+            out += i + 1 < v.size() ? ",\n" : "\n";
+        }
+        out += std::string(indent, ' ') + "]";
+    } else {
+        out += "{\n";
+        const auto& keys = v.getKeys();
+        for (size_t i = 0; i < keys.size(); ++i) {
+            out += pad + UniValue(keys[i]).write() + ": ";
+            Pretty(v[keys[i]], indent + 2, out);
+            out += i + 1 < keys.size() ? ",\n" : "\n";
+        }
+        out += std::string(indent, ' ') + "}";
+    }
+}
+
+void WriteJson(const std::string& dir, const std::string& name, const UniValue& v)
+{
+    std::string text;
+    Pretty(v, 0, text);
+    std::ofstream f(dir + "/" + name, std::ios::binary);
+    BOOST_REQUIRE(f.good());
+    f << text << "\n";
+}
+
+std::string Sha256Hex(const std::vector<unsigned char>& data)
+{
+    unsigned char out[CSHA256::OUTPUT_SIZE];
+    CSHA256().Write(data.data(), data.size()).Finalize(out);
+    return HexStr(out);
+}
+
+// Core serializes `obj` back to exactly `wire`.
+template <typename T>
+bool CoreRoundTrips(const T& obj, const std::vector<unsigned char>& wire)
+{
+    CDataStream out(SER_NETWORK, PROTOCOL_VERSION);
+    out << obj;
+    return out.size() == wire.size() &&
+           std::equal(wire.begin(), wire.end(), reinterpret_cast<const unsigned char*>(out.data()));
+}
+
+UniValue EntryRow(const CSimplifiedMNListEntry& e)
+{
+    UniValue row(UniValue::VARR);
+    row.push_back(e.proRegTxHash.ToString());
+    row.push_back(int{e.nVersion});
+    row.push_back(int{static_cast<uint8_t>(e.nType)});
+    row.push_back(e.isValid);
+    row.push_back(e.CalcHash().ToString());
+    return row;
+}
+
+// BuildCommitmentHash serializes the quorum public key, and Core's key encoding follows the global
+// BLS scheme flag, which block processing sets from the V19 deployment. A commitment's own version
+// records the scheme it was created under (1 and 2 legacy, 3 and 4 basic), so the hash is taken
+// with the flag that matches the commitment.
+UniValue CommitmentRow(const llmq::CFinalCommitment& c)
+{
+    const bool saved = bls::bls_legacy_scheme.load();
+    bls::bls_legacy_scheme.store(c.nVersion == llmq::CFinalCommitment::LEGACY_BLS_NON_INDEXED_QUORUM_VERSION ||
+                                 c.nVersion == llmq::CFinalCommitment::LEGACY_BLS_INDEXED_QUORUM_VERSION);
+    UniValue row(UniValue::VARR);
+    row.push_back(int{static_cast<uint8_t>(c.llmqType)});
+    row.push_back(c.quorumHash.ToString());
+    row.push_back(int{c.quorumIndex});
+    row.push_back(int{c.nVersion});
+    row.push_back(llmq::BuildCommitmentHash(c.llmqType, c.quorumHash, c.validMembers, c.quorumPublicKey, c.quorumVvecHash).ToString());
+    bls::bls_legacy_scheme.store(saved);
+    return row;
+}
+
+UniValue DiffSummary(const CSimplifiedMNListDiff& d)
+{
+    UniValue o(UniValue::VOBJ);
+    o.pushKV("version", int{d.nVersion});
+    o.pushKV("baseBlockHash", d.baseBlockHash.ToString());
+    o.pushKV("blockHash", d.blockHash.ToString());
+    UniValue deleted(UniValue::VARR);
+    for (const auto& h : d.deletedMNs) deleted.push_back(h.ToString());
+    o.pushKV("deletedMNs", deleted);
+    // [proRegTxHash, nVersion, nType, isValid, CalcHash()]
+    UniValue entries(UniValue::VARR);
+    for (const auto& e : d.mnList) entries.push_back(EntryRow(e));
+    o.pushKV("mnList", entries);
+    UniValue deleted_quorums(UniValue::VARR);
+    for (const auto& [type, hash] : d.deletedQuorums) {
+        UniValue row(UniValue::VARR);
+        row.push_back(int{type});
+        row.push_back(hash.ToString());
+        deleted_quorums.push_back(row);
+    }
+    o.pushKV("deletedQuorums", deleted_quorums);
+    // [llmqType, quorumHash, quorumIndex, nVersion, BuildCommitmentHash()]
+    UniValue new_quorums(UniValue::VARR);
+    for (const auto& c : d.newQuorums) new_quorums.push_back(CommitmentRow(c));
+    o.pushKV("newQuorums", new_quorums);
+    o.pushKV("quorumsCLSigGroups", int64_t(d.quorumsCLSigs.size()));
+    return o;
+}
+} // namespace
+
+// Deserialize captured `mnlistdiff` payloads with Core's own `CSimplifiedMNListDiff`, check that
+// Core re-serializes them byte for byte, hash every entry with `CalcHash`, and compare the merkle
+// root of the list a diff leads to with the root in the diff's own coinbase.
+BOOST_AUTO_TEST_CASE(o4_dump_mnlistdiff_ground_truth)
+{
+    std::string manifest_path, out_dir;
+    if (!Env("O4_SML_MANIFEST", manifest_path) || !Env("O4_VECTOR_OUT", out_dir)) return;
+    bls::bls_legacy_scheme.store(false);
+
+    UniValue results(UniValue::VARR);
+    // The list each group has reached so far, keyed by proRegTxHash.
+    std::map<std::string, std::map<uint256, CSimplifiedMNListEntry>> lists;
+
+    const UniValue manifest = ReadManifest(manifest_path);
+    for (const UniValue& item : manifest.getValues()) {
+        const std::string name = item["name"].get_str();
+        const std::string group = item["group"].get_str();
+        const std::vector<unsigned char> wire = ReadFile(item["file"].get_str());
+
+        CDataStream ss(wire, SER_NETWORK, PROTOCOL_VERSION);
+        CSimplifiedMNListDiff diff;
+        ss >> diff;
+        BOOST_CHECK_MESSAGE(ss.empty(), name + ": trailing bytes after the diff");
+        const bool exact = CoreRoundTrips(diff, wire);
+        BOOST_CHECK_MESSAGE(exact, name + ": Core does not re-serialize the capture byte for byte");
+
+        const auto cbtx_opt = GetTxPayload<CCbTx>(diff.cbTx);
+        BOOST_REQUIRE_MESSAGE(cbtx_opt.has_value(), name + ": coinbase has no CbTx payload");
+        const CCbTx& cbtx = *cbtx_opt;
+
+        const bool check_root = item["checkRoot"].isNull() || item["checkRoot"].get_bool();
+        uint256 computed_root;
+        bool roots_match = false;
+        size_t list_size = 0;
+        if (check_root) {
+            auto& list = lists[group];
+            for (const auto& h : diff.deletedMNs) {
+                BOOST_CHECK_MESSAGE(list.erase(h) == 1, name + ": deletes an entry that is not in the list");
+            }
+            for (const auto& e : diff.mnList) list.insert_or_assign(e.proRegTxHash, e);
+
+            std::vector<std::unique_ptr<CSimplifiedMNListEntry>> entries;
+            for (const auto& [hash, e] : list) entries.push_back(std::make_unique<CSimplifiedMNListEntry>(e));
+            const CSimplifiedMNList sml{std::move(entries)};
+            bool mutated = false;
+            computed_root = sml.CalcMerkleRoot(&mutated);
+            roots_match = computed_root == cbtx.merkleRootMNList && !mutated;
+            list_size = list.size();
+            BOOST_CHECK_MESSAGE(roots_match, name + ": merkleRootMNList of the resulting list does not match the coinbase");
+        }
+
+        UniValue r(UniValue::VOBJ);
+        r.pushKV("name", name);
+        if (!item["repoPath"].isNull()) r.pushKV("repoPath", item["repoPath"].get_str());
+        r.pushKV("group", group);
+        r.pushKV("wireBytes", int64_t(wire.size()));
+        r.pushKV("wireSha256", Sha256Hex(wire));
+        r.pushKV("coreRoundTripExact", exact);
+        r.pushKV("cbTxHeight", int{cbtx.nHeight});
+        r.pushKV("cbTxVersion", int{static_cast<uint16_t>(cbtx.nVersion)});
+        r.pushKV("cbTxMerkleRootMNList", cbtx.merkleRootMNList.ToString());
+        if (check_root) {
+            r.pushKV("listSizeAfterDiff", int64_t(list_size));
+            r.pushKV("computedMerkleRootMNList", computed_root.ToString());
+            r.pushKV("rootsMatch", roots_match);
+        }
+        r.pushKV("diff", DiffSummary(diff));
+        results.push_back(r);
+    }
+    WriteJson(out_dir, "mnlistdiff-core-ground-truth.json", results);
+}
+
+// Same for `qrinfo` payloads: Core must decode and re-encode them exactly, and every embedded
+// diff is summarised so Rust decoders can be compared field by field.
+BOOST_AUTO_TEST_CASE(o4_dump_qrinfo_ground_truth)
+{
+    std::string manifest_path, out_dir;
+    if (!Env("O4_QRINFO_MANIFEST", manifest_path) || !Env("O4_VECTOR_OUT", out_dir)) return;
+    bls::bls_legacy_scheme.store(false);
+
+    UniValue results(UniValue::VARR);
+    const UniValue manifest = ReadManifest(manifest_path);
+    for (const UniValue& item : manifest.getValues()) {
+        const std::string name = item["name"].get_str();
+        const std::vector<unsigned char> wire = ReadFile(item["file"].get_str());
+
+        CDataStream ss(wire, SER_NETWORK, PROTOCOL_VERSION);
+        llmq::CQuorumRotationInfo info;
+        ss >> info;
+        BOOST_CHECK_MESSAGE(ss.empty(), name + ": trailing bytes after the qrinfo");
+        const bool exact = CoreRoundTrips(info, wire);
+        BOOST_CHECK_MESSAGE(exact, name + ": Core does not re-serialize the capture byte for byte");
+
+        UniValue r(UniValue::VOBJ);
+        r.pushKV("name", name);
+        if (!item["repoPath"].isNull()) r.pushKV("repoPath", item["repoPath"].get_str());
+        r.pushKV("wireBytes", int64_t(wire.size()));
+        r.pushKV("wireSha256", Sha256Hex(wire));
+        r.pushKV("coreRoundTripExact", exact);
+        r.pushKV("extraShare", info.extraShare);
+        r.pushKV("mnListDiffTip", DiffSummary(info.mnListDiffTip));
+        r.pushKV("mnListDiffH", DiffSummary(info.mnListDiffH));
+        r.pushKV("mnListDiffHMinusC", DiffSummary(info.cycleHMinusC.m_diff));
+        r.pushKV("mnListDiffHMinus2C", DiffSummary(info.cycleHMinus2C.m_diff));
+        r.pushKV("mnListDiffHMinus3C", DiffSummary(info.cycleHMinus3C.m_diff));
+        if (info.extraShare) r.pushKV("mnListDiffHMinus4C", DiffSummary(info.cycleHMinus4C.value_or(llmq::CycleData{}).m_diff));
+        UniValue last(UniValue::VARR);
+        for (const auto& c : info.lastCommitmentPerIndex) last.push_back(CommitmentRow(c));
+        r.pushKV("lastCommitmentPerIndex", last);
+        r.pushKV("quorumSnapshotList", int64_t(info.quorumSnapshotList.size()));
+        r.pushKV("mnListDiffList", int64_t(info.mnListDiffList.size()));
+        results.push_back(r);
+    }
+    WriteJson(out_dir, "qrinfo-core-ground-truth.json", results);
+}
