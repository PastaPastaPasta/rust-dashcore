+// O2a-EV: record the masternode lists and diffs these tests build and read, with what Core
+// computed (evo_snapshot_tests.json under O4_VECTOR_OUT); the checks are unchanged.
+std::vector<unsigned char> Bytes(const CDataStream& s) { return {UCharCast(s.data()), UCharCast(s.data() + s.size())}; }
+
+//! A list as the tests built it: Core's evodb bytes, canonical bytes and CanonicalMNListHash.
+void RecordList(const std::string& name, const CDeterministicMNList& list)
+{
+    if (!o4::Dump::Get().Enabled()) return;
+    CDataStream disk{SER_DISK, CLIENT_VERSION}, canonical{SER_DISK, CLIENT_VERSION};
+    disk << list;
+    evo::SerializeCanonicalMNList(canonical, list);
+    O4_RECORD("evo_snapshot_tests", o4::Obj({{"kind", UniValue{"list"}}, {"case", UniValue{name}},
+                                             {"disk", o4::Hex(Bytes(disk))}, {"canonical", o4::Hex(Bytes(canonical))},
+                                             {"hash", UniValue{HexStr(evo::CanonicalMNListHash(list))}}}));
+}
+
+//! Bytes a test gives UnserializeCanonicalMNList: Core's verdict, re-encoding and hash.
+void RecordRead(const std::string& name, const CDataStream& bytes)
+{
+    if (!o4::Dump::Get().Enabled()) return;
+    UniValue record{o4::Obj({{"kind", UniValue{"read"}}, {"case", UniValue{name}}, {"input", o4::Hex(Bytes(bytes))}})};
+    CDataStream input{bytes};
+    try {
+        const auto list{evo::UnserializeCanonicalMNList(input)};
+        CDataStream canonical{SER_DISK, CLIENT_VERSION};
+        evo::SerializeCanonicalMNList(canonical, list);
+        record.pushKV("accepted", true);
+        record.pushKV("trailing", o4::Int(input.size()));
+        record.pushKV("canonical", o4::Hex(Bytes(canonical)));
+        record.pushKV("hash", HexStr(evo::CanonicalMNListHash(list)));
+    } catch (const std::ios_base::failure& e) {
+        record.pushKV("accepted", false);
+        record.pushKV("error", e.what());
+    }
+    O4_RECORD("evo_snapshot_tests", record);
+}
+
+//! from.BuildDiff(to) in the canonical diff encoding.
+void RecordDiff(const std::string& name, const CDeterministicMNList& from, const CDeterministicMNList& to,
+                const CDeterministicMNListDiff& diff)
+{
+    if (!o4::Dump::Get().Enabled()) return;
+    CDataStream a{SER_DISK, CLIENT_VERSION}, b{SER_DISK, CLIENT_VERSION}, d{SER_DISK, CLIENT_VERSION};
+    evo::SerializeCanonicalMNList(a, from);
+    evo::SerializeCanonicalMNList(b, to);
+    evo::SerializeCanonicalMNListDiff(d, diff);
+    O4_RECORD("evo_snapshot_tests", o4::Obj({{"kind", UniValue{"diff"}}, {"case", UniValue{name}},
+                                             {"from", o4::Hex(Bytes(a))}, {"to", o4::Hex(Bytes(b))},
+                                             {"diff", o4::Hex(Bytes(d))}}));
+}
+
+//! CDeterministicMNStateDiff(old_state, new_state) and its serialization.
+void RecordStateDiff(const std::string& name, const CDeterministicMNState& old_state,
+                     const CDeterministicMNState& new_state, const CDeterministicMNStateDiff& diff)
+{
+    if (!o4::Dump::Get().Enabled()) return;
+    CDataStream a{SER_DISK, CLIENT_VERSION}, b{SER_DISK, CLIENT_VERSION}, d{SER_DISK, CLIENT_VERSION};
+    a << old_state;
+    b << new_state;
+    d << diff;
+    O4_RECORD("evo_snapshot_tests", o4::Obj({{"kind", UniValue{"state_diff"}}, {"case", UniValue{name}},
+                                             {"old", o4::Hex(Bytes(a))}, {"new", o4::Hex(Bytes(b))},
+                                             {"diff", o4::Hex(Bytes(d))}}));
+}
