     }
 };
 
+//! O4: the flags that decide the outcome of CHECKDATASIG(VERIFY). The test draws 4096 random flag
+//! sets; recording each would repeat the same 16 combinations, so a result is recorded once per
+//! (script, stack, flags & O4_CDS_FLAGS), and an outcome that differed for flags equal under the
+//! mask would fail the test, which proves the mask loses nothing the test exercises.
+static constexpr uint32_t O4_CDS_FLAGS = SCRIPT_VERIFY_STRICTENC | SCRIPT_VERIFY_DERSIG | SCRIPT_VERIFY_LOW_S |
+                                         SCRIPT_VERIFY_NULLFAIL;
+
+static void O4Record(uint32_t flags, const stacktype& original_stack, const CScript& script, bool r,
+                     ScriptError err, const stacktype& stack)
+{
+    if (!o4::Dump::Get().Enabled()) return;
+    static std::map<std::string, std::string> outcomes;
+    const std::string key = o4::Obj({{"script", o4::Hex(std::vector<unsigned char>(script.begin(), script.end()))},
+                                     {"stack", o4::HexStack(original_stack)},
+                                     {"flags", o4::Int(flags & O4_CDS_FLAGS)}})
+                                .write();
+    const UniValue outcome = o4::Obj({{"ok", r}, {"error", o4::ScriptErrorName(err)}, {"result_stack", o4::HexStack(stack)}});
+    auto [it, inserted] = outcomes.emplace(key, outcome.write());
+    BOOST_CHECK_MESSAGE(it->second == outcome.write(), "O4: outcome depends on flags outside the mask: " + key);
+    if (inserted) {
+        UniValue rec = o4::Obj({{"script", o4::Hex(std::vector<unsigned char>(script.begin(), script.end()))},
+                                {"stack", o4::HexStack(original_stack)},
+                                {"flags", o4::Int(flags & O4_CDS_FLAGS)},
+                                {"ok", r},
+                                {"error", o4::ScriptErrorName(err)},
+                                {"result_stack", o4::HexStack(stack)}});
+        o4::Dump::Get().Add("checkdatasig_tests", rec);
+    }
+}
+
 static void CheckError(uint32_t flags, const stacktype& original_stack,
                        const CScript& script, ScriptError expected)
 {
@@ -43,6 +74,7 @@ static void CheckError(uint32_t flags, const stacktype& original_stack,
     ScriptError err = ScriptError::SCRIPT_ERR_OK;
     stacktype stack{original_stack};
     bool r = EvalScript(stack, script, flags, sigchecker, SigVersion::BASE, &err);
+    O4Record(flags, original_stack, script, r, err, stack);
     BOOST_CHECK(!r);
     BOOST_CHECK(err == expected);
 }
@@ -54,6 +86,7 @@ static void CheckPass(uint32_t flags, const stacktype& original_stack,
     ScriptError err = ScriptError::SCRIPT_ERR_OK;
     stacktype stack{original_stack};
     bool r = EvalScript(stack, script, flags, sigchecker, SigVersion::BASE, &err);
+    O4Record(flags, original_stack, script, r, err, stack);
     BOOST_CHECK(r);
     BOOST_CHECK(err == ScriptError::SCRIPT_ERR_OK);
     BOOST_CHECK(stack == expected);
