+
+// Node-program task O4: record what Dash Core's own unit tests compute so that it can be reused
+// as test vectors. Everything here is inert unless the O4_VECTOR_OUT environment variable names
+// an output directory; the instrumented tests keep all of their assertions.
+//
+// Each instrumented test calls O4_RECORD("<file>", <UniValue object>) next to the check it
+// mirrors, with the value Core actually computed. At process exit every file is written as
+//   {"source": "<test file>", "records": [ <one record per line> ]}
+// to $O4_VECTOR_OUT/<file>.json.
+
+#include <script/interpreter.h>
+#include <script/script.h>
+#include <util/strencodings.h>
+
+#include <univalue.h>
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace o4 {
+
+class Dump
+{
+public:
+    static Dump& Get()
+    {
+        static Dump instance;
+        return instance;
+    }
+
+    bool Enabled() const { return !m_dir.empty(); }
+
+    void Add(const std::string& file, UniValue record)
+    {
+        if (!Enabled()) return;
+        m_files[file].push_back(std::move(record));
+    }
+
+    //! Like Add(), but at most once per `key`; returns false if `key` was already recorded.
+    bool AddOnce(const std::string& file, const std::string& key, UniValue record)
+    {
+        if (!Enabled()) return false;
+        if (!m_seen.insert(file + '\0' + key).second) return false;
+        m_files[file].push_back(std::move(record));
+        return true;
+    }
+
+    ~Dump()
+    {
+        if (!Enabled()) return;
+        for (const auto& [file, records] : m_files) {
+            std::ofstream out(m_dir + "/" + file + ".json", std::ios::binary);
+            out << "{\n\"source\": " << UniValue("src/test/" + file + ".cpp").write() << ",\n\"records\": [\n";
+            for (size_t i = 0; i < records.size(); ++i) {
+                out << records[i].write() << (i + 1 < records.size() ? ",\n" : "\n");
+            }
+            out << "]\n}\n";
+        }
+    }
+
+private:
+    Dump()
+    {
+        if (const char* dir = std::getenv("O4_VECTOR_OUT"); dir != nullptr) m_dir = dir;
+    }
+
+    std::string m_dir;
+    std::map<std::string, std::vector<UniValue>> m_files;
+    std::set<std::string> m_seen;
+};
+
+inline UniValue Obj(std::initializer_list<std::pair<std::string, UniValue>> members)
+{
+    UniValue o(UniValue::VOBJ);
+    for (const auto& [k, v] : members) o.pushKV(k, v);
+    return o;
+}
+
+inline UniValue Arr(const std::vector<UniValue>& items)
+{
+    UniValue a(UniValue::VARR);
+    for (const auto& i : items) a.push_back(i);
+    return a;
+}
+
+inline UniValue Int(int64_t v) { return UniValue(v); }
+
+inline UniValue Hex(const std::vector<unsigned char>& v) { return UniValue(HexStr(v)); }
+
+inline UniValue HexStack(const std::vector<std::vector<unsigned char>>& stack)
+{
+    UniValue a(UniValue::VARR);
+    for (const auto& item : stack) a.push_back(HexStr(item));
+    return a;
+}
+
+//! The names script_tests.json uses for script errors.
+inline const char* ScriptErrorName(ScriptError err)
+{
+    switch (err) {
+    case SCRIPT_ERR_OK: return "OK";
+    case SCRIPT_ERR_UNKNOWN_ERROR: return "UNKNOWN_ERROR";
+    case SCRIPT_ERR_EVAL_FALSE: return "EVAL_FALSE";
+    case SCRIPT_ERR_OP_RETURN: return "OP_RETURN";
+    case SCRIPT_ERR_SCRIPT_SIZE: return "SCRIPT_SIZE";
+    case SCRIPT_ERR_PUSH_SIZE: return "PUSH_SIZE";
+    case SCRIPT_ERR_OP_COUNT: return "OP_COUNT";
+    case SCRIPT_ERR_STACK_SIZE: return "STACK_SIZE";
+    case SCRIPT_ERR_SIG_COUNT: return "SIG_COUNT";
+    case SCRIPT_ERR_PUBKEY_COUNT: return "PUBKEY_COUNT";
+    case SCRIPT_ERR_VERIFY: return "VERIFY";
+    case SCRIPT_ERR_EQUALVERIFY: return "EQUALVERIFY";
+    case SCRIPT_ERR_CHECKMULTISIGVERIFY: return "CHECKMULTISIGVERIFY";
+    case SCRIPT_ERR_CHECKSIGVERIFY: return "CHECKSIGVERIFY";
+    case SCRIPT_ERR_CHECKDATASIGVERIFY: return "CHECKDATASIGVERIFY";
+    case SCRIPT_ERR_NUMEQUALVERIFY: return "NUMEQUALVERIFY";
+    case SCRIPT_ERR_BAD_OPCODE: return "BAD_OPCODE";
+    case SCRIPT_ERR_DISABLED_OPCODE: return "DISABLED_OPCODE";
+    case SCRIPT_ERR_INVALID_STACK_OPERATION: return "INVALID_STACK_OPERATION";
+    case SCRIPT_ERR_INVALID_ALTSTACK_OPERATION: return "INVALID_ALTSTACK_OPERATION";
+    case SCRIPT_ERR_UNBALANCED_CONDITIONAL: return "UNBALANCED_CONDITIONAL";
+    case SCRIPT_ERR_NEGATIVE_LOCKTIME: return "NEGATIVE_LOCKTIME";
+    case SCRIPT_ERR_UNSATISFIED_LOCKTIME: return "UNSATISFIED_LOCKTIME";
+    case SCRIPT_ERR_SIG_HASHTYPE: return "SIG_HASHTYPE";
+    case SCRIPT_ERR_SIG_DER: return "SIG_DER";
+    case SCRIPT_ERR_MINIMALDATA: return "MINIMALDATA";
+    case SCRIPT_ERR_SIG_PUSHONLY: return "SIG_PUSHONLY";
+    case SCRIPT_ERR_SIG_HIGH_S: return "SIG_HIGH_S";
+    case SCRIPT_ERR_SIG_NULLDUMMY: return "SIG_NULLDUMMY";
+    case SCRIPT_ERR_PUBKEYTYPE: return "PUBKEYTYPE";
+    case SCRIPT_ERR_CLEANSTACK: return "CLEANSTACK";
+    case SCRIPT_ERR_SIG_NULLFAIL: return "NULLFAIL";
+    case SCRIPT_ERR_DISCOURAGE_UPGRADABLE_NOPS: return "DISCOURAGE_UPGRADABLE_NOPS";
+    case SCRIPT_ERR_INVALID_SPLIT_RANGE: return "SPLIT_RANGE";
+    case SCRIPT_ERR_INVALID_OPERAND_SIZE: return "OPERAND_SIZE";
+    case SCRIPT_ERR_INVALID_NUMBER_RANGE: return "INVALID_NUMBER_RANGE";
+    case SCRIPT_ERR_DIV_BY_ZERO: return "DIV_BY_ZERO";
+    case SCRIPT_ERR_MOD_BY_ZERO: return "MOD_BY_ZERO";
+    case SCRIPT_ERR_OP_CODESEPARATOR: return "OP_CODESEPARATOR";
+    case SCRIPT_ERR_SIG_FINDANDDELETE: return "SIG_FINDANDDELETE";
+    case SCRIPT_ERR_IMPOSSIBLE_ENCODING: return "IMPOSSIBLE_ENCODING";
+    case SCRIPT_ERR_ERROR_COUNT: break;
+    }
+    return "UNKNOWN";
+}
+
+//! Selection for the DIP0020 opcode test, which sweeps every operand width from 1 to 521 bytes with
+//! many patterns (95k evaluations, 130 MB of JSON). Every evaluation whose script and operands are
+//! at most 33 bytes is kept (this covers the 4-byte CScriptNum limit, the 8- and 32-byte widths and
+//! the push-size boundaries). Wider ones are kept only at the element-size limit (520 and 521
+//! bytes), and only six per (final opcode, outcome), which gives every opcode both its limit
+//! success and its limit failures. Evaluations are deduplicated by (script, stack, flags).
+inline bool KeepDip0020(const CScript& script, const std::vector<std::vector<unsigned char>>& in,
+                        const std::vector<std::vector<unsigned char>>& out, uint32_t flags, ScriptError err)
+{
+    static std::set<std::string> seen;
+    static std::map<std::string, int> wide_per_outcome;
+    size_t widest = script.size();
+    for (const auto& item : in) widest = std::max(widest, item.size());
+    for (const auto& item : out) widest = std::max(widest, item.size());
+    if (widest > 33 && widest < 520) return false;
+    std::string key = HexStr(script) + "|" + std::to_string(flags);
+    for (const auto& item : in) key += "|" + HexStr(item);
+    if (!seen.insert(key).second) return false;
+    if (widest >= 520) {
+        const std::string outcome = std::to_string(script.empty() ? -1 : script.back()) + "|" + ScriptErrorName(err);
+        if (++wide_per_outcome[outcome] > 6) return false;
+    }
+    return true;
+}
+
+} // namespace o4
+
+#define O4_RECORD(file, record)                                       \
+    do {                                                              \
+        if (o4::Dump::Get().Enabled()) o4::Dump::Get().Add(file, record); \
+    } while (0)
+
+#endif // BITCOIN_TEST_UTIL_O4_DUMP_H
